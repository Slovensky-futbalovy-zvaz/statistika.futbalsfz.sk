---
// /zvaz/{id} — kanonický profil zväzu (cieľ menu „Profil zväzu" a klikov v mape).
// Renderuje redizajnovaný SezonaProfil pre najnovšiu futbalovú sezónu (s medziročným porovnaním).
import Base from '../../layouts/Base.astro';
import SezonaProfil from '../../components/SezonaProfil.astro';
import { getZvazy, getZvaz, getProfil } from '../../lib/data';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () =>
  getZvazy().map((z) => ({ params: { id: z.id } }));

const { id } = Astro.params;
const z = getZvaz(id!);
if (!z) throw new Error(`Zväz ${id} nie je v index.json`);

// Default = posledná KOMPLETNÁ sezóna zväzu (aspoň polovica max. objemu zápasov),
// aby kanonický profil neukazoval práve začatú sezónu (napr. 2026/2027) takmer prázdnu.
const profily = z.sezony.map((s) => ({ s, p: getProfil(z.id, s) }));
const maxZ = Math.max(...profily.map((x) => x.p?.kpi.zapasy ?? 0), 1);
const kompletne = profily.filter((x) => (x.p?.kpi.zapasy ?? 0) >= maxZ * 0.5);
const sezona = (kompletne.length ? kompletne[kompletne.length - 1].s : z.sezony[z.sezony.length - 1]);
const profil = sezona ? getProfil(z.id, sezona) : undefined;

const idxSezony = sezona ? z.sezony.indexOf(sezona) : -1;
const predoslaSezona = idxSezony > 0 ? z.sezony[idxSezony - 1] : undefined;
const predosly = predoslaSezona ? getProfil(z.id, predoslaSezona) : undefined;
---

<Base title={z.nazov}>
  {
    sezona && profil ? (
      <SezonaProfil
        z={z}
        sezona={sezona}
        odvetvie="futbal"
        profil={profil}
        predoslaSezona={predoslaSezona}
        predosly={predosly}
      />
    ) : (
      <p class="text-muted">Pre tento zväz zatiaľ nie sú dostupné žiadne sezónne dáta.</p>
    )
  }
</Base>
