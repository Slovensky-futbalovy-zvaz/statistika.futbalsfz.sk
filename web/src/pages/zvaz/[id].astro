---
// /zvaz/{id} — kanonický profil zväzu (cieľ menu „Profil zväzu" a klikov v mape).
// Renderuje redizajnovaný SezonaProfil pre najnovšiu futbalovú sezónu (s medziročným porovnaním).
import Base from '../../layouts/Base.astro';
import SezonaProfil from '../../components/SezonaProfil.astro';
import KpiTrend from '../../components/KpiTrend.tsx';
import { getZvazy, getZvaz, getProfil, fmt } from '../../lib/data';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () =>
  getZvazy().map((z) => ({ params: { id: z.id } }));

const { id } = Astro.params;
const z = getZvaz(id!);
if (!z) throw new Error(`Zväz ${id} nie je v index.json`);

// Default = posledná KOMPLETNÁ sezóna zväzu (aspoň polovica max. objemu zápasov),
// aby kanonický profil neukazoval práve začatú sezónu (napr. 2026/2027) takmer prázdnu.
const profily = z.sezony.map((s) => ({ s, p: getProfil(z.id, s) }));
const maxZ = Math.max(...profily.map((x) => x.p?.kpi.zapasy ?? 0), 1);
const kompletne = profily.filter((x) => (x.p?.kpi.zapasy ?? 0) >= maxZ * 0.5);
const sezona = (kompletne.length ? kompletne[kompletne.length - 1].s : z.sezony[z.sezony.length - 1]);
const profil = sezona ? getProfil(z.id, sezona) : undefined;

const idxSezony = sezona ? z.sezony.indexOf(sezona) : -1;
const predoslaSezona = idxSezony > 0 ? z.sezony[idxSezony - 1] : undefined;
const predosly = predoslaSezona ? getProfil(z.id, predoslaSezona) : undefined;

const trendPerSeason: Record<string, any> = {};
for (const s of z.sezony) { const pr = getProfil(z.id, s); if (pr) trendPerSeason[s] = (pr as any).kategorie ?? {}; }

const popis = profil
  ? `${z.nazov} (${z.uroven}) — štatistiky sezóny ${sezona}: ${fmt(profil.kpi.zapasy)} zápasov, ${fmt(profil.kpi.goly)} gólov, ${fmt(profil.osoby?.hraci?.unikatni ?? 0)} hráčov. Kategórie, osoby a veková štruktúra.`
  : `${z.nazov} (${z.uroven}) — profil zväzu v portáli Štatistiky slovenského futbalu.`;
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Prehľad', item: 'https://statistika.futbalsfz.sk/' },
    { '@type': 'ListItem', position: 2, name: 'Zväzy', item: 'https://statistika.futbalsfz.sk/zvaz/sfz' },
    { '@type': 'ListItem', position: 3, name: z.nazov, item: `https://statistika.futbalsfz.sk/zvaz/${z.id}` },
  ],
};
---

<Base
  title={z.nazov}
  description={popis}
  image="/og/zvaz.png"
  jsonLd={[breadcrumb]}
  sezony={z.sezony}
  aktualnaSezona={sezona}
  seasonHrefTemplate={`/zvaz/${z.id}/{sezona}`}
>
  {
    sezona && profil ? (
      <SezonaProfil
        z={z}
        sezona={sezona}
        odvetvie="futbal"
        profil={profil}
        predoslaSezona={predoslaSezona}
        predosly={predosly}
      />
    ) : (
      <p class="text-muted">Pre tento zväz zatiaľ nie sú dostupné žiadne sezónne dáta.</p>
    )
  }

  <section class="mt-6 border border-line" style="background:var(--color-card); border-radius:16px; padding:18px; box-shadow:var(--shadow-card);">
    <div class="text-xs font-bold uppercase tracking-[0.14em] text-sfz-blue">Vývoj v čase · vekové úrovne</div>
    <h2 class="font-extrabold tracking-tight" style="font-size:20px; margin:2px 0 2px;">Ukazovatele naprieč sezónami</h2>
    <p class="text-sm text-muted mb-3">Reálne odohrané zápasy (a góly, diváci, karty, družstvá) po vekových skupinách. Prepni metriku a skupiny.</p>
    <KpiTrend client:visible sezony={z.sezony} perSeason={trendPerSeason} />
  </section>
</Base>
