---
import Base from '../../layouts/Base.astro';
import PorovnanieView from '../../components/PorovnanieView.astro';
import { getPorovnanie, sezonyUrovne, getBumpDataRfz, poslednaKompletnaSlug, porovnanieCielovaSlug, porovnanieKlubyDefaultSlug } from '../../lib/data';

// /porovnanie = plné porovnanie pre default úroveň RFZ + posledná KOMPLETNÁ sezóna
const uroven = 'rfz';
const rfzSez = sezonyUrovne('rfz'); // zostupne
const kompletnaSlug = poslednaKompletnaSlug();
const sezonaSlug = rfzSez.includes(kompletnaSlug) ? kompletnaSlug : rfzSez[0];
const porovnanie = getPorovnanie(uroven, sezonaSlug);
const sezony = sezonyUrovne(uroven);
const bump = getBumpDataRfz();
const klubySlug = porovnanieKlubyDefaultSlug();

const urovne = [
  { slug: 'rfz', label: 'RFZ', href: null as string | null },
  { slug: 'obfz', label: 'ObFZ', href: null as string | null },
  ...(klubySlug ? [{ slug: 'kluby', label: 'Kluby', href: `/porovnanie/kluby/${klubySlug}` }] : []),
];
---

<Base
  title="Porovnania zväzov"
  description="Porovnanie regionálnych (RFZ) a oblastných (ObFZ) zväzov slovenského futbalu — zoraditeľné rebríčky, radar priameho porovnania a vývoj poradia v čase. Zápasy, góly, diváci, hráči a ďalšie ukazovatele."
  image="/og/porovnanie.png"
  keywords="porovnanie zväzov, rebríček RFZ, ObFZ štatistiky, futbal Slovensko porovnanie"
  sezony={sezony.map((s) => s.replace('-', '/'))}
  aktualnaSezona={sezonaSlug.replace('-', '/')}
  seasonHrefTemplate={`/porovnanie/${uroven}/{sezona}`}
>
  <header class="mb-6">
    <div class="text-xs font-bold uppercase tracking-[0.14em] text-sfz-blue">Porovnania a radenie</div>
    <h1 class="mt-1 font-extrabold tracking-tight" style="font-size:clamp(21px,2.4vw,28px);">Ktorý zväz vedie?</h1>
    <p class="mt-1 text-muted">
      Zoraď zväzy podľa ľubovoľného ukazovateľa. Klikni na riadok pre profil zväzu.
    </p>
  </header>

  <div class="flex flex-wrap items-center gap-2 mb-6">
    <div class="inline-flex rounded-xl p-[3px]" style="background:var(--color-track);">
      {
        urovne.map((u) => (
          <a
            href={u.href ?? (u.slug === uroven ? '/porovnanie' : `/porovnanie/${u.slug}/${porovnanieCielovaSlug(u.slug, sezonaSlug)}`)}
            class:list={[
              'rounded-[9px] px-3.5 py-1 text-sm font-bold',
              u.slug === uroven ? 'bg-card text-sfz-blue shadow-sm' : 'text-muted',
            ]}
          >
            {u.label}
          </a>
        ))
      }
    </div>
  </div>

  <PorovnanieView porovnanie={porovnanie} bump={uroven === 'rfz' ? bump : undefined} />


  <p class="mt-8 text-xs text-muted">
    Generované {porovnanie.generatedAt} · len uzavreté zápasy · historicky môžu byť „družstvá" nižšie
    (staršie sezóny nemajú vždy vyplnené súpisky).
  </p>
</Base>
