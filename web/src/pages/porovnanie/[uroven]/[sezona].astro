---
import Base from '../../../layouts/Base.astro';
import PorovnanieView from '../../../components/PorovnanieView.astro';
import BumpChart from '../../../components/BumpChart.tsx';
import { getPorovnaniaZoznam, getPorovnanie, sezonyUrovne, getBumpDataRfz, porovnanieCielovaSlug } from '../../../lib/data';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () =>
  getPorovnaniaZoznam().map((p) => ({ params: { uroven: p.urovenSlug, sezona: p.sezonaSlug } }));

const { uroven, sezona: sezonaSlug } = Astro.params;
const porovnanie = getPorovnanie(uroven!, sezonaSlug!);
const sezony = sezonyUrovne(uroven!);
const bump = getBumpDataRfz();

const urovne = [
  { slug: 'rfz', label: 'RFZ' },
  { slug: 'obfz', label: 'ObFZ' },
];
---

<Base
  title={`Porovnanie ${porovnanie.uroven} ${porovnanie.sezona}`}
  description={`Porovnanie zväzov (${porovnanie.uroven}) v sezóne ${porovnanie.sezona} — ${porovnanie.pocetZvazov} zväzov zoradených podľa zápasov, gólov, divákov či hráčov. Rebríček, radar a vývoj poradia v čase.`}
  image="/og/porovnanie.png"
  sezony={sezony.map((s) => s.replace('-', '/'))}
  aktualnaSezona={sezonaSlug.replace('-', '/')}
  seasonHrefTemplate={`/porovnanie/${uroven}/{sezona}`}
>
  <header class="mb-6">
    <div class="text-xs font-bold uppercase tracking-[0.14em] text-sfz-blue">Porovnania a radenie</div>
    <h1 class="mt-1 font-extrabold tracking-tight" style="font-size:clamp(21px,2.4vw,28px);">Ktorý zväz vedie?</h1>
    <p class="mt-1 text-muted">
      {porovnanie.uroven} · sezóna {porovnanie.sezona} · {porovnanie.pocetZvazov} zväzov. Klikni na riadok pre profil.
    </p>
  </header>

  <div class="flex flex-wrap items-center gap-2 mb-6">
    <div class="inline-flex rounded-xl p-[3px]" style="background:var(--color-track);">
      {
        urovne.map((u) => (
          <a
            href={u.slug === uroven ? `/porovnanie/${u.slug}/${sezonaSlug}` : `/porovnanie/${u.slug}/${porovnanieCielovaSlug(u.slug, sezonaSlug!)}`}
            class:list={[
              'rounded-[9px] px-3.5 py-1 text-sm font-bold',
              u.slug === uroven ? 'bg-card text-sfz-blue shadow-sm' : 'text-muted',
            ]}
          >
            {u.label}
          </a>
        ))
      }
    </div>
  </div>

  <PorovnanieView porovnanie={porovnanie} />

  {
    bump.sezony.length > 1 && (
      <section class="mt-12">
        <h2 class="text-lg font-bold mb-1">Vývoj poradia RFZ v čase</h2>
        <p class="text-sm text-muted mb-3">
          Poradie 4 regionálnych zväzov naprieč {bump.sezony.length} sezónami podľa zvolenej metriky (1. = najlepší).
        </p>
        <div class="border border-line" style="background:var(--color-card); border-radius:16px; padding:18px; box-shadow:var(--shadow-card);">
          <BumpChart client:visible bump={bump} />
        </div>
      </section>
    )
  }

  <p class="mt-8 text-xs text-sfz-muted">
    Generované {porovnanie.generatedAt} · len uzavreté zápasy · historicky môžu byť „družstvá" nižšie
    (staršie sezóny nemajú vždy vyplnené súpisky).
  </p>
</Base>
