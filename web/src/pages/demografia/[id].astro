---
import Base from '../../layouts/Base.astro';
import DemografiaSekcia from '../../components/DemografiaSekcia.tsx';
import AgePyramid from '../../components/AgePyramid.tsx';
import ZvazPicker from '../../components/ZvazPicker.tsx';
import { getZvazy, getZvaz, getDemografia } from '../../lib/data';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () =>
  getZvazy()
    .filter((z) => getDemografia(z.id))
    .map((z) => ({ params: { id: z.id } }));

const { id } = Astro.params;
const z = getZvaz(id!);
if (!z) throw new Error(`Zväz ${id} nie je v index.json`);
const demo = getDemografia(z.id);
const vsetkyZvazy = getZvazy().map((zz) => ({ id: zz.id, nazov: zz.nazov, uroven: zz.uroven, rfz: zz.rfz }));
---

<Base title={`Demografia — ${z.nazov}`}>
  <header class="mb-6 flex flex-wrap items-start justify-between gap-3">
    <div>
      <div class="text-xs font-bold uppercase tracking-[0.14em] text-sfz-blue">Demografia osôb · {z.uroven}</div>
      <h1 class="mt-1 font-extrabold tracking-tight" style="font-size:clamp(28px,4vw,44px);">{z.nazov}</h1>
      <p class="mt-1 text-sm"><a href="/demografia" class="text-sfz-blue hover:underline">← Celé Slovensko</a></p>
    </div>
    <div>
      <div class="text-xs font-semibold uppercase tracking-wider text-muted mb-1 text-right">Vybrať iný zväz</div>
      <ZvazPicker client:load zvazy={vsetkyZvazy} aktualne={z.id} hrefTemplate="/demografia/{id}" />
    </div>
  </header>

  {
    demo ? (
      <>
        <DemografiaSekcia client:load demo={demo} />
        <section class="mt-4 border border-line" style="background:var(--color-card); border-radius:16px; padding:18px; box-shadow:var(--shadow-card);">
          <div class="text-xs font-bold uppercase tracking-[0.14em] text-sfz-blue">Veková štruktúra</div>
          <h2 class="font-extrabold" style="font-size:20px; margin:2px 0 2px;">Veková pyramída</h2>
          <p class="text-sm text-muted mb-3">Registrované osoby podľa veku a pohlavia. Prepni rolu.</p>
          <AgePyramid client:visible demo={demo} />
        </section>
      </>
    ) : (
      <p class="text-muted">Pre tento zväz nie sú demografické dáta.</p>
    )
  }
</Base>
