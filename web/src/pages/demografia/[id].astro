---
import Base from '../../layouts/Base.astro';
import DemografiaLines from '../../components/DemografiaLines.tsx';
import VekovaPyramida from '../../components/VekovaPyramida.astro';
import ZvazPicker from '../../components/ZvazPicker.tsx';
import { getZvazy, getZvaz, getDemografia } from '../../lib/data';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () =>
  getZvazy()
    .filter((z) => getDemografia(z.id))
    .map((z) => ({ params: { id: z.id } }));

const { id } = Astro.params;
const z = getZvaz(id!);
if (!z) throw new Error(`Zväz ${id} nie je v index.json`);
const demo = getDemografia(z.id);
const vsetkyZvazy = getZvazy().map((zz) => ({ id: zz.id, nazov: zz.nazov, uroven: zz.uroven, rfz: zz.rfz }));
---

<Base title={`Demografia — ${z.nazov}`}>
  <header class="mb-6 flex flex-wrap items-start justify-between gap-3">
    <div>
      <div class="text-xs font-semibold uppercase tracking-wider text-muted">Demografia · {z.uroven}</div>
      <h1 class="text-3xl font-extrabold tracking-tight">{z.nazov}</h1>
      <p class="mt-1 text-sm"><a href="/demografia" class="text-sfz-blue hover:underline">← Celé Slovensko</a></p>
    </div>
    <ZvazPicker client:load zvazy={vsetkyZvazy} aktualne={z.id} hrefTemplate="/demografia/{id}" />
  </header>

  {
    demo ? (
      <>
        <section class="border border-line" style="background:var(--color-card); border-radius:16px; padding:18px; box-shadow:var(--shadow-card);">
          <h2 class="text-lg font-bold mb-1">Trend podľa vekových úrovní</h2>
          <p class="text-sm text-muted mb-3">Jedna čiara na každú vybranú kategóriu alebo vekovú úroveň.</p>
          <DemografiaLines client:load demo={demo} />
        </section>

        <section class="mt-8 border border-line" style="background:var(--color-card); border-radius:16px; padding:18px; box-shadow:var(--shadow-card);">
          <h2 class="text-lg font-bold mb-1">Veková pyramída</h2>
          <p class="text-sm text-muted mb-3">Vek × pohlavie podľa roly a sezóny.</p>
          <VekovaPyramida demo={demo} />
        </section>
      </>
    ) : (
      <p class="text-muted">Pre tento zväz nie sú demografické dáta.</p>
    )
  }
</Base>
