---
import Base from '../../layouts/Base.astro';
import DemografiaSekcia from '../../components/DemografiaSekcia.tsx';
import AgePyramid from '../../components/AgePyramid.tsx';
import ZvazPicker from '../../components/ZvazPicker.tsx';
import { getSumarDemografia, getZvazy, poslednaKompletnaSlug } from '../../lib/data';

const srDemo = getSumarDemografia();
const vsetkyZvazy = getZvazy().map((zz) => ({ id: zz.id, nazov: zz.nazov, uroven: zz.uroven, rfz: zz.rfz }));
// Kozmetický badge 'OBDOBIE' v hlavičke (#4 klubový plán) — táto stránka zámerne zobrazuje trend
// cez VŠETKY sezóny naraz (nie per-sezónny filter), preto namiesto SEZÓNA pickera len rozsah rokov.
const sezonyListSr = srDemo ? Object.keys(srDemo.sezony).sort() : [];
// Prebiehajúca sezóna sa nesmie čítať ako stav — mládež sa prihlasuje neskôr než dospelí.
// Rovnaká hranica ako pri Indexe klubu a vekových trendoch: posledná KOMPLETNÁ sezóna.
const kompletnaSr = poslednaKompletnaSlug().replace('-', '/');
const prebiehaSr = sezonyListSr.length > 0 && sezonyListSr[sezonyListSr.length - 1] !== kompletnaSr;
const obdobieSr = sezonyListSr.length
  ? sezonyListSr.length > 1
    ? `${sezonyListSr[0]}–${sezonyListSr[sezonyListSr.length - 1]}`
    : sezonyListSr[0]
  : undefined;
---

<Base
  title="Demografia futbalu"
  description="Demografia slovenského futbalu — ako rastie futbalová komunita. Vývoj počtu registrovaných osôb (hráči, tréneri, rozhodcovia, delegáti) podľa veku, pohlavia a vekových kategórií za posledné sezóny."
  image="/og/demografia.png"
  keywords="demografia futbal, počet hráčov Slovensko, futbalová mládež, registrované osoby SFZ"
>
  <header class="mb-6 flex flex-wrap items-start justify-between gap-3">
    <div>
      <div class="text-xs font-bold uppercase tracking-[0.14em] text-sfz-blue">Demografia osôb</div>
      <h1 class="mt-1 font-extrabold tracking-tight" style="font-size:clamp(28px,4vw,44px);">Ako rastie futbalová komunita</h1>
      <p class="mt-2 max-w-2xl text-muted">
        Vývoj počtu registrovaných osôb v slovenskom futbale — porovnaj vekové kategórie a úrovne
        ako samostatné čiary. Súčet všetkých zväzov.
      </p>
      {
        obdobieSr && (
          <span
            class="mt-3 inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1 text-xs font-bold text-ink"
            style="background:var(--color-card);"
          >
            <span class="text-muted" style="font-size:10px; letter-spacing:.14em;">OBDOBIE</span> {obdobieSr}
          </span>
        )
      }
    </div>
    <div>
      <div class="text-xs font-semibold uppercase tracking-wider text-muted mb-1 text-right">Vybrať zväz</div>
      <ZvazPicker client:load zvazy={vsetkyZvazy} aktualne="" hrefTemplate="/demografia/{id}" />
    </div>
  </header>

  {
    srDemo ? (
      <>
        <DemografiaSekcia client:load demo={srDemo} poslednaKompletna={kompletnaSr} />
        <section class="mt-4 border border-line" style="background:var(--color-card); border-radius:16px; padding:18px; box-shadow:var(--shadow-card);">
          <div class="text-xs font-bold uppercase tracking-[0.14em] text-sfz-blue">Veková štruktúra</div>
          <h2 class="font-extrabold" style="font-size:20px; margin:2px 0 2px;">Veková pyramída</h2>
          <p class="text-sm text-muted mb-3">Registrované osoby podľa veku a pohlavia. Prepni rolu.</p>
          <AgePyramid client:visible demo={srDemo} prebieha={prebiehaSr} />
        </section>
      </>
    ) : (
      <p class="text-muted">Demografické dáta zatiaľ nie sú dostupné.</p>
    )
  }
</Base>
