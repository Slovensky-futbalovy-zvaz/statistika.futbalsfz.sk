---
// Stránka Trendy — vekové zloženie hráčov v zápasoch dospelých a Index klubu.
// Metodika: claude/plan-trendy-vek.md a claude/metodika-index-klubu.md v projekte.
import Base from '../layouts/Base.astro';
import IndexTabulka from '../components/IndexTabulka.tsx';
import StarnuceKluby from '../components/StarnuceKluby.tsx';
import VekTrendZvazov from '../components/VekTrendZvazov.tsx';
import ZanikanieKlubov from '../components/ZanikanieKlubov.tsx';
import { getIndexPrehlad, getIndexZvazovVCase, getStarnuceKluby, getVekZvazovVCase, getZanikanie } from '../lib/trendy';
import { getZvazy, klubyZvazu } from '../lib/data';

const prehlad = getIndexPrehlad();
const starnuce = getStarnuceKluby(3);
const vekZvazov = getVekZvazovVCase();
const indexZvazov = getIndexZvazovVCase();
const zanikanie = getZanikanie();

const INDEX_POZNAMKA =
  'Medián Indexu klubu medzi klubmi zväzu. Kluby bez mládeže sa započítavajú s nulou — sú ' +
  'súčasťou reality zväzu, nie chybou merania. ' +
  (indexZvazov.porovnatelneOd
    ? `Prerušovaný úsek na začiatku (do ${indexZvazov.porovnatelneOd}) NIE JE porovnateľný ` +
      'so zvyškom — zložka kontinuity dáva plných 15 bodov až za päť sezón mládeže po sebe, ' +
      'a história začína 2013/2014, takže v prvých sezónach ju nemohol mať plnú nikto. ' +
      'Väčšina rastu v tomto úseku je artefakt metodiky, nie zlepšenie mládeže. '
    : '') +
  'Rez radí klub podľa najvyššej dospelej súťaže, v ktorej v danej sezóne hral; čítaj ho ' +
  'opatrne — kluby medzi úrovňami postupujú a padajú, takže séria nie je ten istý súbor ' +
  'klubov naprieč sezónami. Kluby bez dospelého družstva majú vlastný rez. Prebiehajúca ' +
  'sezóna sa nezobrazuje vôbec — mládežnícke družstvá v nej ešte nie sú prihlásené. ' +
  'Zobrazujú sa len zväzy a sezóny s aspoň piatimi klubmi.';

// klub → zväz (na filter v tabuľke indexu)
const klubZvaz: Record<string, string> = {};
const zvazy = getZvazy();
for (const z of zvazy) {
  for (const k of klubyZvazu(z.id)) klubZvaz[k.id] = z.id;
}

// Kompaktná serializácia — 1 400+ klubov by ako pole objektov stránku nafúklo.
const indexRows = (prehlad?.kluby ?? [])
  .map((r) => [
    r.klub, r.nazov, r.index, r.stav,
    r.zlozky.A, r.zlozky.B, r.zlozky.C, r.zlozky.D, r.zlozky.E ?? '',
    r.detaily.skupiny, r.detaily.deti, r.detaily.druzstvaMladez, r.detaily.sezonPoSebe,
    r.detaily.podielMladych ?? '',
  ].join('|'))
  .join('\n');

const starnuceRows = starnuce
  .map((r) => [
    r.klub, r.nazov, Math.round(r.trend * 100), r.medianPrva, r.medianPosledna,
    Math.round(r.zmenaHracov), r.zapisov, Math.round(r.doU21 * 1000),
  ].join('|'))
  .join('\n');

const okno = starnuce.length ? starnuce[0].sezony : [];

// Toky po sezónach. Hodnotiteľné sú len sezóny, za ktorými sú ešte dve nasledujúce (definícia:
// dva roky bez družstva). Príchody sa navyše počítajú až od tretej sezóny okna — v druhej by sa
// medzi „nové“ započítali všetky kluby, ktoré si prvú vynechali.
const zanikHodn = zanikanie?.hodnotitelne ?? [];
const zanikToky: [string, number, number][] = zanikHodn
  .slice(2)
  .map((sez) => [sez, zanikanie?.zanik[sez]?.spolu ?? 0, zanikanie?.prislo[sez]?.spolu ?? 0]);

const zanikZvazy = Object.entries(zanikanie?.zvazy ?? {})
  .map(([id, z]) => ({ id, ...z }))
  .filter((z) => z.klubosezony > 0);

const zanikObdobia = Object.entries(zanikanie?.poObdobiach ?? {}).map(([nazov, o]) => ({ nazov, ...o }));

const zanikOkno: [string, string] = zanikHodn.length
  ? [zanikHodn[0], zanikHodn[zanikHodn.length - 1]]
  : ['', ''];

const KICKER = 'text-xs font-bold uppercase tracking-[0.14em] text-sfz-blue';
const CARD = 'border border-line';
const CARD_STYLE = 'background:var(--color-card); border-radius:16px; padding:18px; box-shadow:var(--shadow-card);';
---

<Base
  title="Trendy"
  description="Ako sa vyvíja vek hráčov v zápasoch dospelých po zväzoch a kluboch, ktoré kluby najrýchlejšie starnú a Index klubu — meranie mládežníckej základne všetkých klubov na Slovensku."
  keywords="vek hráčov futbal, starnutie klubov, index klubu, mládež vo futbale, ObFZ kluby, štatistiky SFZ"
  image="/og/trendy.png"
>
  <header class="mb-6">
    <div class={KICKER}>Vývoj v čase</div>
    <h1 class="mt-1 font-extrabold tracking-tight" style="font-size:clamp(28px,4vw,44px);">Trendy</h1>
    <p class="mt-2 max-w-3xl text-muted">
      Ako sa mení futbal na Slovensku v čase. Zatiaľ vek hráčov v zápasoch dospelých,
      zanikanie klubov a mládežnícka základňa klubov — ďalšie trendy budú pribúdať.
    </p>
  </header>

  <!-- vek po zväzoch -->
  <section class="mb-8">
    <div class={CARD} style={CARD_STYLE}>
      <div class={KICKER}>Vek hráčov</div>
      <h2 class="font-extrabold" style="font-size:20px; margin:2px 0 4px;">Ako starne futbal dospelých</h2>
      <p class="text-sm text-muted mb-3" style="line-height:1.6;">
        Medián veku hráčov uvedených v zápise o stretnutí v súťažiach dospelých, po zväzoch
        a sezónach. Vek je <strong class="text-ink">veková úroveň osoby</strong> — koncový rok
        sezóny mínus ročník narodenia, teda tak, ako sa vek vo futbale používa. Jednotka je jeden
        zápis hráča v jednom zápase, takže opora váži viac než jednorazová výpomoc.
      </p>
      <VekTrendZvazov client:visible data={vekZvazov} />
    </div>
  </section>

  <!-- starnúce kluby -->
  <section class="mb-8">
    <div class={CARD} style={CARD_STYLE}>
      <div class={KICKER}>Zdravie klubov</div>
      <h2 class="font-extrabold" style="font-size:20px; margin:2px 0 4px;">Kluby, ktoré najrýchlejšie starnú</h2>
      <p class="text-sm text-muted mb-3" style="line-height:1.6;">
        Klub, ktorému rok čo rok rastie vek dospelého družstva, nedopĺňa mladých — a o pár
        sezón nemusí mať kto hrať. Rebríček preto zoraďuje kluby podľa toho, o koľko rokov
        ročne im vek stúpa.
      </p>
      <StarnuceKluby client:visible rows={starnuceRows} okno={okno} />
    </div>
  </section>

  <!-- vývoj indexu po zväzoch -->
  <section class="mb-8">
    <div class={CARD} style={CARD_STYLE}>
      <div class={KICKER}>Index klubu</div>
      <h2 class="font-extrabold" style="font-size:20px; margin:2px 0 4px;">Ako rastie mládežnícka základňa</h2>
      <p class="text-sm text-muted mb-3" style="line-height:1.6;">
        Ten istý pohľad ako pri veku, len namiesto rokov je na osi <strong class="text-ink">Index
        klubu</strong> — číslo od 0 do 100, ktoré meria mládežnícku základňu klubu. Čiara je
        medián medzi klubmi zväzu, teda typický klub, nie ten najlepší ani priemer ťahaný
        veľkými mestskými klubmi.
      </p>
      <VekTrendZvazov
        client:visible
        data={indexZvazov}
        jednotka="bodov"
        pocetSlovo="klubov"
        rezSlovo="Najvyššia súťaž klubu"
        poznamka={INDEX_POZNAMKA}
      />
    </div>
  </section>

  <!-- zanikanie klubov -->
  <section class="mb-8">
    <div class={CARD} style={CARD_STYLE}>
      <div class={KICKER}>Zanikanie klubov</div>
      <h2 class="font-extrabold" style="font-size:20px; margin:2px 0 4px;">Kde a kedy kluby končia</h2>
      <p class="text-sm text-muted mb-3" style="line-height:1.6;">
        Za zaniknutý klub považujeme klub, ktorý <strong class="text-ink">dva roky po sebe
        neprihlási do súťaže žiadne družstvo</strong>. Koniec v súťažiach dospelých zánik nie je,
        pokiaľ klub má mládež, a postup ani zostup zánik nie je už vôbec. Graf ukazuje, koľko
        klubov každú sezónu zaniklo a koľko nových pribudlo; tabuľka pod ním, ktorých zväzov sa
        to týka najviac.
      </p>
      {
        zanikToky.length ? (
          <ZanikanieKlubov
            client:visible
            toky={zanikToky}
            zvazy={zanikZvazy}
            obdobia={zanikObdobia}
            okno={zanikOkno}
            spolu={zanikanie?.zanikovSpolu ?? 0}
            obnovenych={zanikanie?.obnovenychSpolu ?? 0}
            presuny={zanikanie?.presunyMedziZvazmi ?? { zmien: 0, dvojicSezon: 0, podiel: 0, klubovSoZmenou: 0 }}
          />
        ) : (
          <p class="text-sm text-muted">Dáta o zanikaní klubov sa zatiaľ nepodarilo načítať.</p>
        )
      }
    </div>
  </section>

  <!-- index klubu -->
  <section class="mb-8">
    <div class={CARD} style={CARD_STYLE}>
      <div class={KICKER}>Index klubu</div>
      <h2 class="font-extrabold" style="font-size:20px; margin:2px 0 4px;">Mládežnícka základňa klubov</h2>
      <p class="text-sm text-muted mb-3" style="line-height:1.6;">
        Index klubu je číslo od 0 do 100, ktoré meria mládežnícku základňu klubu a jej
        udržateľnosť: či má klub dorast, žiakov aj prípravky, koľko detí v nich hrá, koľko
        má družstiev, ako dlho mládež udržuje a či sa jeho mladí dostanú do dospelého družstva.
      </p>
      {
        prehlad ? (
          <IndexTabulka
            client:visible
            rows={indexRows}
            sezona={prehlad.sezona}
            zvazy={zvazy.map((z) => ({ id: z.id, nazov: z.nazov }))}
            klubZvaz={klubZvaz}
          />
        ) : (
          <p class="text-sm text-muted">Index sa zatiaľ nepodarilo načítať.</p>
        )
      }
    </div>
  </section>

  <p class="text-xs text-muted">
    Podrobná metodika je v <a href="/dokumentacia" class="text-sfz-blue hover:underline">dokumentácii</a>.
  </p>
</Base>
