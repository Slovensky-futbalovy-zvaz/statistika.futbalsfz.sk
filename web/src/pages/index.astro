---
import Base from '../layouts/Base.astro';
import MapaSR from '../components/MapaSR.astro';
import Ikona from '../components/Ikona.astro';
import { getZvazy, getSumarSezony, getSumar, fmt } from '../lib/data';

const zvazy = getZvazy();
const sfz = zvazy.find((z) => z.uroven === 'SFZ');
const rfzZvazy = zvazy.filter((z) => z.uroven === 'RFZ');
const obfz = zvazy.filter((z) => z.uroven === 'ObFZ');

const rfzPoradie = ['BFZ', 'ZsFZ', 'SsFZ', 'VsFZ'];
const rfzNazov: Record<string, string> = Object.fromEntries(
  rfzZvazy.map((r) => [r.appSpace, r.nazov]),
);
const obfzPodlaRfz = rfzPoradie.map((skratka) => ({
  skratka,
  nazov: rfzNazov[skratka] ?? skratka,
  zvazy: obfz.filter((o) => o.rfz === skratka).sort((a, b) => a.nazov.localeCompare(b.nazov, 'sk')),
}));

// aktuálna sezóna = najnovšia so sumárom (sezóna začína 1. 7.)
const sumarSezony = getSumarSezony();
const aktualna = sumarSezony.length ? sumarSezony[sumarSezony.length - 1] : undefined;
const sumar = aktualna ? getSumar(aktualna) : undefined;

// KPI za celé SR (futbal + futsal): pripočítaj odvetvia k futbalovým súčtom
const KPI = ['sutaze', 'zapasy', 'druzstva', 'goly', 'divaci', 'zlteKarty', 'cerveneKarty'] as const;
const kpiSpolu: Record<string, number> = {};
if (sumar) {
  for (const k of KPI) kpiSpolu[k] = (sumar.kpi as Record<string, number>)[k] ?? 0;
  for (const o of Object.values(sumar.odvetvia)) {
    for (const k of KPI) kpiSpolu[k] += (o.kpi as Record<string, number>)[k] ?? 0;
  }
}
const kpiKarty = [
  { key: 'sutaze', label: 'Súťaže' },
  { key: 'druzstva', label: 'Družstvá' },
  { key: 'zapasy', label: 'Zápasy' },
  { key: 'goly', label: 'Góly' },
  { key: 'divaci', label: 'Diváci' },
  { key: 'zlteKarty', label: 'Žlté karty' },
  { key: 'cerveneKarty', label: 'Červené karty' },
];

// osoby po roliach za celé SR (futbal + futsal)
const osobySpolu: Record<string, number> = {};
if (sumar) {
  for (const [k, v] of Object.entries(sumar.osoby)) osobySpolu[k] = v;
  for (const o of Object.values(sumar.odvetvia)) {
    for (const [k, v] of Object.entries(o.osoby)) osobySpolu[k] = (osobySpolu[k] ?? 0) + v;
  }
}
const osobyKarty = [
  { key: 'spolu', label: 'Osoby spolu' },
  { key: 'hraci', label: 'Hráči' },
  { key: 'treneri', label: 'Tréneri' },
  { key: 'rozhodcovia', label: 'Rozhodcovia' },
  { key: 'delegati', label: 'Delegáti' },
  { key: 'personal', label: 'Personál' },
];
---

<Base>
  <section class="mb-8">
    <h1 class="text-3xl font-extrabold tracking-tight">Štatistiky slovenského futbalu</h1>
    <p class="mt-2 max-w-2xl text-sfz-muted">
      Sezónne štatistiky naprieč celou futbalovou pyramídou — Slovenský futbalový zväz, 4 regionálne
      a 38 oblastných zväzov. Vyberte zväz na mape alebo zo zoznamu.
    </p>
  </section>

  {
    sumar && (
      <section class="mb-10">
        <div class="flex items-baseline justify-between gap-3 mb-3">
          <h2 class="text-lg font-bold">Aktuálna sezóna {aktualna}</h2>
          <a href="/prehlad" class="text-sm text-sfz-blue hover:underline">Celý prehľad →</a>
        </div>
        <p class="text-xs text-sfz-muted mb-4">
          Súhrn za všetky zväzy (futbal aj futsal). Sezóna sa začala 1. 7. — dáta pribúdajú s
          uzatváraním zápasov.
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3">
          {kpiKarty.map((k) => (
            <div class="rounded-xl border border-black/10 p-4">
              <div class="text-sfz-blue mb-1.5">
                <Ikona name={k.key} class="w-5 h-5" />
              </div>
              <div class="text-2xl font-extrabold tabular-nums">{fmt(kpiSpolu[k.key] ?? 0)}</div>
              <div class="text-sm text-sfz-muted">{k.label}</div>
            </div>
          ))}
        </div>

        <h3 class="mt-6 mb-3 text-sm font-semibold uppercase tracking-wider text-sfz-muted">
          Osoby vo futbale
        </h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
          {osobyKarty.map((k) => (
            <div class="rounded-xl border border-black/10 p-4">
              <div class="text-sfz-blue mb-1.5">
                <Ikona name={k.key} class="w-5 h-5" />
              </div>
              <div class="text-2xl font-extrabold tabular-nums">{fmt(osobySpolu[k.key] ?? 0)}</div>
              <div class="text-sm text-sfz-muted">{k.label}</div>
            </div>
          ))}
        </div>
        <p class="mt-2 text-xs text-sfz-muted">
          Osoba pôsobiaca vo viacerých zväzoch alebo roliach sa počíta v každom z nich.
        </p>
      </section>
    )
  }

  <section class="mb-12 grid gap-8 md:grid-cols-[1.4fr_1fr] items-start">
    <div class="rounded-xl border border-black/10 p-3">
      <MapaSR />
    </div>
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-sfz-muted">Zväzy</h2>
      <ul class="mt-3 space-y-1">
        {
          sfz && (
            <li>
              <a class="font-semibold text-sfz-blue hover:underline" href={`/zvaz/${sfz.id}`}>
                {sfz.nazov}
              </a>
            </li>
          )
        }
        {
          rfzZvazy.map((r) => (
            <li>
              <a class="text-sfz-blue hover:underline" href={`/zvaz/${r.id}`}>
                {r.nazov}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    obfzPodlaRfz.map((skupina) => (
      <section class="mb-8">
        <h2 class="text-lg font-bold border-b border-black/10 pb-1 mb-3">
          {skupina.nazov} <span class="text-sfz-muted font-normal">· {skupina.zvazy.length} ObFZ</span>
        </h2>
        <ul class="grid gap-x-6 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
          {skupina.zvazy.map((o) => (
            <li>
              <a class="text-sfz-blue hover:underline" href={`/zvaz/${o.id}`}>
                {o.nazov}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
