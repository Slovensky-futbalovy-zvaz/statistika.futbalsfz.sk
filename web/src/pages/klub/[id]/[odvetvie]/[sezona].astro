---
// Klubová sezónna stránka pre odvetvia mimo futbalu (dnes futsal), zrkadlová k
// /klub/[id]/[sezona].astro (futbal) — konvencia zdieľaná so /zvaz/[id]/[odvetvie]/[sezona].
import Base from '../../../../layouts/Base.astro';
import CategoryDrill from '../../../../components/CategoryDrill.tsx';
import KlubPicker from '../../../../components/KlubPicker.tsx';
import { fmt, delta } from '../../../../lib/format';
import { GROUPS } from '../../../../lib/palette';
import {
  getKlubSezony,
  getKluby,
  getKlubyOdvetvie,
  getKlubProfilOdvetvie,
  getZvaz,
  odvetviaKlubu,
  ODVETVIE_LABEL,
} from '../../../../lib/data';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () =>
  ['futsal'].flatMap((sektor) =>
    getKlubyOdvetvie(sektor).flatMap((k) =>
      k.sezony.map((s) => ({
        params: { id: k.id, odvetvie: sektor, sezona: s.replace('/', '-') },
      })),
    ),
  );

const { id, odvetvie, sezona: sezonaUrl } = Astro.params;
const sezona = sezonaUrl!.replace('-', '/');
const klub = getKlubProfilOdvetvie(id!, sezona, odvetvie!);
if (!klub) throw new Error(`Klub ${id} ${odvetvie} ${sezona} neexistuje`);

const zaznamOdvetvia = getKlubyOdvetvie(odvetvie!).find((k) => k.id === id);
const sezony = zaznamOdvetvia?.sezony ?? [sezona]; // sezóny klubu v tomto odvetví
const sezonyPaged = sezony; // zatiaľ bez okna — počet sezón na odvetvie je malý

const idxSez = sezony.indexOf(sezona);
const predoslaSezona = idxSez > 0 ? sezony[idxSez - 1] : undefined;
const predosly = predoslaSezona ? getKlubProfilOdvetvie(id!, predoslaSezona, odvetvie!) : undefined;

const klubyItems = getKluby().map((k) => ({ id: k.id, nazov: k.nazov, zvazNazov: k.zvazNazov, uroven: k.uroven, sezony: k.sezony }));
const zvaz = klub.zvaz ? getZvaz(klub.zvaz) : undefined;

function odvetvieUrl(o: string, s: string): string {
  const slug = s.replace('/', '-');
  return o === 'futbal' ? `/klub/${id}/${slug}` : `/klub/${id}/${o}/${slug}`;
}
const sezonyFutbal = getKlubSezony(id!);
const prepinacOdvetvi = odvetviaKlubu(id!, sezonyFutbal).map((o) => {
  const ciel = o.sezony.includes(sezona) ? sezona : o.sezony[o.sezony.length - 1];
  return { odvetvie: o.odvetvie, label: ODVETVIE_LABEL[o.odvetvie] ?? o.odvetvie, url: odvetvieUrl(o.odvetvie, ciel) };
});

const REGION_FARBA: Record<string, string> = { sfz: '#7a44e0', bfz: '#1450df', zsfz: '#2f9bff', ssfz: '#12a06b', vsfz: '#f0961b' };
const pilulkaFarba = REGION_FARBA[klub.zvaz ?? ''] ?? (klub.uroven === 'ObFZ' ? '#f0961b' : '#1450df');

const odvetvieLabel = ODVETVIE_LABEL[odvetvie!] ?? odvetvie;
const popis = `${klub.nazov} — ${odvetvieLabel}, štatistiky sezóny ${sezona}: ${fmt(klub.kpi.zapasy)} zápasov, ${fmt(klub.kpi.goly)} gólov, ${fmt(klub.osoby?.hraci?.unikatni ?? 0)} hráčov.`;
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Prehľad', item: 'https://statistika.futbalsfz.sk/' },
    { '@type': 'ListItem', position: 2, name: 'Kluby', item: 'https://statistika.futbalsfz.sk/kluby' },
    { '@type': 'ListItem', position: 3, name: `${klub.nazov} · ${odvetvieLabel}`, item: `https://statistika.futbalsfz.sk/klub/${id}/${odvetvie}/${sezonaUrl}` },
  ],
};

const kpiKarty = [
  { label: 'Zápasy', hodnota: klub.kpi.zapasy, predch: predosly?.kpi.zapasy, good: true },
  { label: 'Družstvá', hodnota: klub.kpi.druzstva, predch: predosly?.kpi.druzstva, good: true },
  { label: 'Góly', hodnota: klub.kpi.goly, predch: predosly?.kpi.goly, good: true },
  { label: 'Diváci', hodnota: klub.kpi.divaci, predch: predosly?.kpi.divaci, good: true },
  { label: 'Žlté karty', hodnota: klub.kpi.zlteKarty, predch: predosly?.kpi.zlteKarty, good: false },
  { label: 'Červené karty', hodnota: klub.kpi.cerveneKarty, predch: predosly?.kpi.cerveneKarty, good: false },
];

const osobaLabel: Record<string, string> = { hraci: 'Hráči', treneri: 'Tréneri', realizacnyTim: 'Realizačný tím' };
function rozpadSkupin(poKat: Record<string, number>) {
  return GROUPS.map((g) => ({ key: g.key, color: g.color, hodnota: g.cats.reduce((s, c) => s + (poKat[c] ?? 0), 0) })).filter((r) => r.hodnota > 0);
}
const osobyKarty = Object.entries(klub.osoby)
  .filter(([, o]) => (o.unikatni ?? 0) > 0)
  .map(([rola, o]) => {
    const skupiny = rozpadSkupin(o.poKategorii ?? {});
    return { rola, label: osobaLabel[rola] ?? rola, unikatni: o.unikatni, skupiny, max: Math.max(1, ...skupiny.map((s) => s.hodnota)) };
  });

const CARD = 'border border-line';
const CS = 'background:var(--color-card); border-radius:16px; padding:18px; box-shadow:var(--shadow-card);';
---

<Base title={`${klub.nazov} — ${odvetvieLabel} ${sezona}`} description={popis} image="/og/kluby.png" jsonLd={[breadcrumb]}>
  <p class="mb-3 text-sm"><a href="/kluby" class="text-sfz-blue hover:underline">← Kluby</a></p>

  <header class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <span class="inline-block rounded-full px-3 py-0.5 text-xs font-bold" style={`background:${pilulkaFarba}1f; color:${pilulkaFarba};`}>{klub.uroven || 'Klub'}</span>
      <h1 class="mt-2 font-extrabold tracking-tight" style="font-size:clamp(26px,4vw,44px); line-height:1.05;">{klub.nazov}</h1>
      <p class="mt-1 text-muted text-sm">
        {
          zvaz ? (
            <>Riadiaci zväz: <a href={`/zvaz/${zvaz.id}`} class="font-semibold text-sfz-blue hover:underline">{zvaz.nazov}</a> ↗ · {odvetvieLabel} · sezóna {sezona}</>
          ) : (
            <>{odvetvieLabel} · sezóna {sezona}</>
          )
        }
      </p>
      {
        prepinacOdvetvi.length > 1 && (
          <div class="mt-3 flex flex-wrap gap-1.5">
            {prepinacOdvetvi.map((o) => (
              <a
                href={o.url}
                class:list={[
                  'rounded-full border px-3 py-0.5 text-sm',
                  o.odvetvie === odvetvie
                    ? 'border-sfz-blue bg-sfz-blue text-white font-semibold'
                    : 'border-black/10 text-sfz-blue hover:bg-black/5',
                ]}
              >
                {o.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
    <div>
      <div class="text-xs font-semibold uppercase tracking-wider text-muted mb-1 text-right">Vybrať iný klub</div>
      <KlubPicker client:load kluby={klubyItems} aktualne={id} />
    </div>
  </header>

  <div class="mb-6 flex flex-wrap items-center gap-1.5">
    <span class="mr-1 text-xs font-semibold uppercase tracking-wider text-muted">Sezóna:</span>
    {
      sezonyPaged.slice().reverse().map((s) => (
        <a href={odvetvieUrl(odvetvie!, s)} class:list={['rounded-md border px-2 py-0.5 text-sm', s === sezona ? 'border-sfz-blue bg-sfz-blue text-white font-semibold' : 'border-black/10 text-sfz-blue hover:bg-black/5']}>{s}</a>
      ))
    }
  </div>

  <section class="grid gap-3.5" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr));">
    {
      kpiKarty.map((k) => {
        const d = delta(k.hodnota, k.predch, k.good);
        return (
          <div class={CARD} style={CS + ' container-type:inline-size;'}>
            <div class="text-[11px] font-bold uppercase tracking-wider text-muted">{k.label}</div>
            <div class="tnum mt-1.5 font-extrabold" style="font-size:clamp(20px,16cqi,30px); line-height:1.05; white-space:nowrap;">{fmt(k.hodnota)}</div>
            {d && (
              <div class="mt-1 text-xs"><span class="tnum font-semibold" style={`color:${d.color};`}>{d.arrow} {d.text}</span><span class="text-muted"> medziročne</span></div>
            )}
          </div>
        );
      })
    }
  </section>
  {predoslaSezona && <p class="mt-2 text-xs text-muted">Medziročná zmena oproti sezóne {predoslaSezona}.</p>}

  <section class="mt-8 border border-line" style={CS}>
    <div class="text-xs font-bold uppercase tracking-[0.14em] text-sfz-blue">Vekové kategórie</div>
    <h2 class="font-extrabold" style="font-size:20px; margin:2px 0 2px;">Zápasy podľa kategórií</h2>
    <p class="text-sm text-muted mb-3">Klikni na kategóriu pre rozpad na konkrétne vekové úrovne. Klub môže mať družstvá vo viacerých kategóriách.</p>
    <CategoryDrill client:visible kategorie={klub.kategorie} />
  </section>

  {
    osobyKarty.length > 0 && (
      <section class="mt-8">
        <div class="text-xs font-bold uppercase tracking-[0.14em] text-sfz-blue">Osoby v klube</div>
        <h2 class="font-extrabold" style="font-size:20px; margin:2px 0 6px;">Ľudia v klube</h2>
        <p class="text-sm text-muted mb-4">Unikátni hráči a tréneri klubu podľa vekovej kategórie. Súčet po kategóriách môže prevyšovať počet unikátnych osôb (viacnásobné pôsobenie).</p>
        <div class="grid gap-3.5" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr));">
          {osobyKarty.map((o) => (
            <div class={CARD} style={CS}>
              <div class="text-[11px] font-bold uppercase tracking-wider text-muted">{o.label}</div>
              <div class="tnum text-3xl font-extrabold mt-0.5">{fmt(o.unikatni)}</div>
              <div class="mt-3 flex flex-col gap-1.5">
                {o.skupiny.map((s) => (
                  <div class="flex items-center gap-2 text-xs">
                    <span style={`color:${s.color}; width:64px;`}>{s.key}</span>
                    <span class="flex-1 h-2 rounded-full" style="background:var(--color-track);">
                      <span class="block h-full rounded-full" style={`width:${(s.hodnota / o.max) * 100}%; background:${s.color};`} />
                    </span>
                    <span class="tnum text-right" style="width:52px;">{fmt(s.hodnota)}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <p class="mt-8 text-xs text-muted">
    <b>Metodika:</b> len uzavreté zápasy; klub = organizácia (`teams.organization`). Góly a karty priradené tímu klubu z protokolu; osoby = hráči a tréneri klubu (rozhodcovia/delegáti nie sú klubové). Diváci = návštevnosť zápasov klubu (pokrytie {Math.round(((klub.methodologyFlags?.divaciPokrytie as number) ?? 0) * 100)} %). Dáta generované {klub.generatedAt}.
  </p>
</Base>
