---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string; // OG obrázok (cesta od rootu, napr. /og/kluby.png)
  keywords?: string;
  noindex?: boolean;
  jsonLd?: unknown[]; // per-page structured data (BreadcrumbList, Dataset, FAQPage…)
  sezony?: string[];
  aktualnaSezona?: string;
  seasonHrefTemplate?: string;
}
const {
  title = 'Štatistiky slovenského futbalu',
  description = 'Verejný štatistický portál slovenského futbalu — kompletné čísla za SFZ, 4 regionálne (RFZ) a 38 oblastných (ObFZ) zväzov: zápasy, góly, diváci, kluby aj registrované osoby po sezónach.',
  image = '/og/default.png',
  keywords,
  noindex = false,
  jsonLd = [],
  sezony,
  aktualnaSezona,
  seasonHrefTemplate,
} = Astro.props;

const SITE = 'Štatistiky slovenského futbalu';
const fullTitle = title === SITE ? title : `${title} · ${SITE}`;
const pathname = Astro.url.pathname;
const site = Astro.site ?? new URL('https://statistika.futbalsfz.sk');
const canonical = new URL(pathname, site).href;
const ogImage = new URL(image, site).href;

// Site-wide structured data (na každej stránke).
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: 'Slovenský futbalový zväz',
  alternateName: 'SFZ',
  url: 'https://futbalsfz.sk',
  sport: 'Football',
  logo: new URL('/sfz-logo-official.svg', site).href,
};
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE,
  url: site.href,
  inLanguage: 'sk-SK',
  description,
  publisher: { '@type': 'SportsOrganization', name: 'Slovenský futbalový zväz' },
};
const allLd = [orgLd, siteLd, ...jsonLd];
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1'} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content="Slovenský futbalový zväz" />
    <meta name="theme-color" content="#1450df" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:locale" content="sk_SK" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/sfz-logo-official.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Archivo+Expanded:wght@600;700;800;900&display=swap"
      rel="stylesheet"
    />
    {allLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body class="min-h-screen flex flex-col">
    <Header
      pathname={pathname}
      sezony={sezony}
      aktualnaSezona={aktualnaSezona}
      seasonHrefTemplate={seasonHrefTemplate}
    />

    <main class="mx-auto flex-1 w-full" style="max-width:1240px; padding:34px 24px 70px;">
      <slot />
    </main>

    <footer class="border-t border-line mt-12">
      <div class="mx-auto text-sm text-muted" style="max-width:1240px; padding:24px;">
        © Slovenský futbalový zväz · Zdroj dát: platforma sportnet.online
      </div>
    </footer>
  </body>
</html>
