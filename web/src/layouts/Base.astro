---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string; // OG obrázok (cesta od rootu, napr. /og/kluby.png)
  keywords?: string;
  noindex?: boolean;
  jsonLd?: unknown[]; // per-page structured data (BreadcrumbList, Dataset, FAQPage…)
  sezony?: string[];
  aktualnaSezona?: string;
  seasonHrefTemplate?: string;
}
const {
  title = 'Štatistiky slovenského futbalu',
  description = 'Verejný štatistický portál slovenského futbalu — kompletné čísla za SFZ, 4 regionálne (RFZ) a 38 oblastných (ObFZ) zväzov: zápasy, góly, diváci, kluby aj registrované osoby po sezónach.',
  image = '/og/default.png',
  keywords,
  noindex = false,
  jsonLd = [],
  sezony,
  aktualnaSezona,
  seasonHrefTemplate,
} = Astro.props;

const SITE = 'Štatistiky slovenského futbalu';
const fullTitle = title === SITE ? title : `${title} · ${SITE}`;
const pathname = Astro.url.pathname;
const site = Astro.site ?? new URL('https://statistika.futbalsfz.sk');
const canonical = new URL(pathname, site).href;
const ogImage = new URL(image, site).href;

// Site-wide structured data (na každej stránke).
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: 'Slovenský futbalový zväz',
  alternateName: 'SFZ',
  url: 'https://futbalsfz.sk',
  sport: 'Football',
  logo: new URL('/sfz-logo-official.svg', site).href,
};
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE,
  url: site.href,
  inLanguage: 'sk-SK',
  description,
  publisher: { '@type': 'SportsOrganization', name: 'Slovenský futbalový zväz' },
};
const allLd = [orgLd, siteLd, ...jsonLd];
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1'} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content="Slovenský futbalový zväz" />
    <meta name="theme-color" content="#1450df" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:locale" content="sk_SK" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/sfz-logo-official.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Archivo+Expanded:wght@600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <!-- Google Analytics (gtag.js) + Consent Mode v2 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7T4VV89NZJ" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500
      });
      gtag('js', new Date());
      gtag('config', 'G-7T4VV89NZJ');
      try {
        if (localStorage.getItem('ga-consent') === 'granted') {
          gtag('consent', 'update', { analytics_storage: 'granted' });
        }
      } catch (e) {}
    </script>
    {allLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body class="min-h-screen flex flex-col">
    <Header
      pathname={pathname}
      sezony={sezony}
      aktualnaSezona={aktualnaSezona}
      seasonHrefTemplate={seasonHrefTemplate}
    />

    <main class="mx-auto flex-1 w-full" style="max-width:1240px; padding:34px 24px 70px;">
      <slot />
    </main>

    <footer class="border-t border-line mt-12">
      <div class="mx-auto text-sm text-muted" style="max-width:1240px; padding:24px;">
        © Slovenský futbalový zväz · Zdroj dát: platforma <a href="https://sportnet.online" target="_blank" rel="noopener" class="text-sfz-blue hover:underline">sportnet.online</a>.<br />
        Autor štatistík: <a href="mailto:jan.letko@futbalsfz.sk" class="text-sfz-blue hover:underline">Ján Letko</a> · 2026 · za know-how ďakujeme <a href="https://ltk.solutions" target="_blank" rel="noopener" class="text-sfz-blue hover:underline">LTK Solutions, s.r.o.</a>
      </div>
    </footer>
    <!-- Cookie consent banner (GA) -->
    <div id="cookie-banner" hidden style="position:fixed;left:0;right:0;bottom:0;z-index:60;background:#0f1830;color:#fff;border-top:3px solid #1450df;box-shadow:0 -6px 24px rgba(0,0,0,.25);">
      <div style="max-width:1240px;margin:0 auto;padding:16px 24px;display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;">
        <p style="margin:0;font-size:14px;line-height:1.5;max-width:780px;">
          Na anonymné meranie návštevnosti používame Google Analytics. Súbory cookies nastavíme až s tvojím súhlasom. Viac v <a href="/dokumentacia" style="color:#8fb0ff;text-decoration:underline;">Dokumentácii</a>.
        </p>
        <div style="display:flex;gap:10px;flex-shrink:0;">
          <button id="cookie-decline" type="button" style="cursor:pointer;padding:9px 16px;border-radius:8px;border:1px solid rgba(255,255,255,.35);background:transparent;color:#fff;font-weight:600;font-size:14px;">Odmietnuť</button>
          <button id="cookie-accept" type="button" style="cursor:pointer;padding:9px 16px;border-radius:8px;border:0;background:#1450df;color:#fff;font-weight:700;font-size:14px;">Súhlasím</button>
        </div>
      </div>
    </div>
    <script is:inline>
      (function () {
        var KEY = 'ga-consent';
        var el = document.getElementById('cookie-banner');
        var v = null;
        try { v = localStorage.getItem(KEY); } catch (e) {}
        if (!v && el) el.hidden = false;
        function choose(val) {
          try { localStorage.setItem(KEY, val); } catch (e) {}
          if (val === 'granted' && typeof gtag === 'function') {
            gtag('consent', 'update', { analytics_storage: 'granted' });
          }
          if (el) el.hidden = true;
        }
        var a = document.getElementById('cookie-accept');
        var d = document.getElementById('cookie-decline');
        if (a) a.addEventListener('click', function () { choose('granted'); });
        if (d) d.addEventListener('click', function () { choose('denied'); });
      })();
    </script>
  </body>
</html>
