---
// ECharts island — veková pyramída (vek × pohlavie) z data/demografia.
// Dáta sú uložené po rokoch narodenia; na osi sa zobrazuje VEK vypočítaný
// z koncového roka zvolenej sezóny (rozhodnutie PO 19. 7. 2026).
// Prepínače roly a sezóny sú pill tagy v dvoch riadkoch (rozhodnutie PO
// 19. 7. 2026); dáta všetkých sezón × rolí sú v payloade (gzip ich zrazí).
import { ROLY_PORADIE, ROLA_LABEL } from '../lib/data';
import type { Demografia } from '../lib/data';

interface Props {
  demo: Demografia;
}
const { demo } = Astro.props;

// payload: sezóna → rola → { roky, bezUdajov } (len roly s aspoň 1 osobou)
const sezony = Object.keys(demo.sezony).sort();
const payload: Record<string, Record<string, { roky: Record<string, Record<string, number>>; bezUdajov: number }>> = {};
for (const s of sezony) {
  payload[s] = {};
  for (const rola of ROLY_PORADIE) {
    const r = demo.sezony[s]?.[rola];
    if (r && r.osoby > 0) payload[s][rola] = { roky: r.roky, bezUdajov: r.bezUdajov };
  }
}
const rolyLabels: Record<string, string> = ROLA_LABEL;
---

<div data-pyramida data-payload={JSON.stringify(payload)} data-roly={JSON.stringify(rolyLabels)}>
  <div class="mb-1.5 flex flex-wrap items-center gap-1.5">
    <span class="text-sm text-sfz-muted mr-1">Rola:</span>
    <div class="roly-pills flex flex-wrap gap-1.5" role="group" aria-label="Výber roly"></div>
  </div>
  <div class="mb-3 flex flex-wrap items-center gap-1.5">
    <span class="text-sm text-sfz-muted mr-1">Sezóna:</span>
    <div class="sezony-pills flex flex-wrap gap-1.5" role="group" aria-label="Výber sezóny"></div>
  </div>
  <div
    class="pyramida-chart w-full"
    style="height: 520px;"
    role="img"
    aria-label="Veková pyramída — vek × pohlavie"
  >
  </div>
  <p class="pyramida-note text-xs text-sfz-muted mt-2"></p>
</div>

<script>
  import * as echarts from 'echarts/core';
  import { BarChart } from 'echarts/charts';
  import { GridComponent, TooltipComponent, LegendComponent } from 'echarts/components';
  import { CanvasRenderer } from 'echarts/renderers';
  echarts.use([BarChart, GridComponent, TooltipComponent, LegendComponent, CanvasRenderer]);

  type Roky = Record<string, Record<string, number>>;
  type Payload = Record<string, Record<string, { roky: Roky; bezUdajov: number }>>;
  const nf = new Intl.NumberFormat('sk-SK');

  const AKTIVNY = 'rounded-full border px-3 py-0.5 text-sm border-sfz-blue bg-sfz-blue text-white font-semibold';
  const NEAKTIVNY = 'rounded-full border px-3 py-0.5 text-sm border-black/10 text-sfz-blue hover:bg-black/5';

  const root = document.querySelector<HTMLElement>('[data-pyramida]');
  if (root) {
    const payload = JSON.parse(root.dataset.payload ?? '{}') as Payload;
    const rolaLabel = JSON.parse(root.dataset.roly ?? '{}') as Record<string, string>;
    const sezony = Object.keys(payload).sort().reverse(); // najnovšia prvá
    const rolyPoradie = Object.keys(rolaLabel);

    const rolyEl = root.querySelector<HTMLElement>('.roly-pills')!;
    const sezonyEl = root.querySelector<HTMLElement>('.sezony-pills')!;
    const noteEl = root.querySelector<HTMLElement>('.pyramida-note')!;
    const chartEl = root.querySelector<HTMLElement>('.pyramida-chart')!;
    const chart = echarts.init(chartEl, undefined, { renderer: 'canvas' });

    let sezona = sezony[0];
    let rola = '';

    /** Roly dostupné vo zvolenej sezóne (s aspoň 1 osobou), v kanonickom poradí. */
    function dostupneRoly(): string[] {
      const d = Object.keys(payload[sezona] ?? {});
      return rolyPoradie.filter((r) => d.includes(r));
    }

    function pills(
      el: HTMLElement,
      polozky: { k: string; label: string }[],
      aktivna: string,
      onPick: (k: string) => void,
    ) {
      el.innerHTML = polozky
        .map(
          (p) =>
            `<button type="button" data-k="${p.k}" aria-pressed="${p.k === aktivna}" class="${
              p.k === aktivna ? AKTIVNY : NEAKTIVNY
            }">${p.label}</button>`,
        )
        .join('');
      el.querySelectorAll<HTMLButtonElement>('button').forEach((b) =>
        b.addEventListener('click', () => onPick(b.dataset.k!)),
      );
    }

    function renderOvladanie() {
      const roly = dostupneRoly();
      if (!roly.includes(rola)) rola = roly[0] ?? '';
      pills(rolyEl, roly.map((r) => ({ k: r, label: rolaLabel[r] ?? r })), rola, (k) => {
        rola = k;
        render();
      });
      pills(sezonyEl, sezony.map((s) => ({ k: s, label: s })), sezona, (k) => {
        sezona = k;
        renderOvladanie();
        render();
      });
    }

    function render() {
      renderOvladanie();
      const data = payload[sezona]?.[rola];
      if (!data) return;

      // vek = koncový rok sezóny − rok narodenia; rok desc → vek vzostupne zdola
      const koncovyRok = parseInt(sezona.split('/')[1] ?? '0', 10);
      const roky = Object.keys(data.roky).sort().reverse();
      const veky = roky.map((r) => String(koncovyRok - parseInt(r, 10)));
      const m = roky.map((r) => -(data.roky[r].M ?? 0)); // muži vľavo (záporné)
      const f = roky.map((r) => data.roky[r].F ?? 0);
      const n = roky.reduce((acc, r) => acc + (data.roky[r].N ?? 0), 0);
      const maxAbs = Math.max(...m.map(Math.abs), ...f, 1);

      chart.setOption(
        {
          legend: { top: 0, data: ['Muži', 'Ženy'] },
          tooltip: {
            trigger: 'axis',
            axisPointer: { type: 'shadow' },
            formatter: (params: any) => {
              const vek = params[0]?.axisValue ?? '';
              const rok = koncovyRok - parseInt(vek, 10);
              const riadky = params.map(
                (p: any) => `${p.seriesName}: <b>${nf.format(Math.abs(p.value))}</b>`,
              );
              return `Vek <b>${vek}</b> (nar. ${rok})<br/>${riadky.join('<br/>')}`;
            },
          },
          grid: { left: 8, right: 24, top: 28, bottom: 10, containLabel: true },
          xAxis: {
            type: 'value',
            min: -maxAbs,
            max: maxAbs,
            axisLabel: { formatter: (v: number) => nf.format(Math.abs(v)), fontSize: 10 },
          },
          yAxis: {
            type: 'category',
            name: 'Vek',
            nameTextStyle: { fontSize: 10 },
            data: veky,
            axisLabel: { fontSize: 9 },
            axisTick: { show: false },
          },
          series: [
            {
              name: 'Muži',
              type: 'bar',
              stack: 'p',
              data: m,
              itemStyle: { color: '#1450df' },
              barCategoryGap: '20%',
            },
            { name: 'Ženy', type: 'bar', stack: 'p', data: f, itemStyle: { color: '#ec1c24' } },
          ],
        },
        true,
      );

      const poznamky = [`Sezóna ${sezona} · ${rolaLabel[rola] ?? rola}.`];
      if (n > 0) poznamky.push(`${nf.format(n)} osôb bez uvedeného pohlavia (nezobrazené).`);
      if (data.bezUdajov > 0)
        poznamky.push(`${nf.format(data.bezUdajov)} osôb bez dátumu narodenia (mimo pyramídy).`);
      noteEl.textContent = poznamky.join(' ');
    }

    render();
    new ResizeObserver(() => chart.resize()).observe(chartEl);
  }
</script>
