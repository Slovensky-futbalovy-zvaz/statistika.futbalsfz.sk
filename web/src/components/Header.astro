---
import SeasonPicker from './SeasonPicker.tsx';
import MobileMenu from './MobileMenu.tsx';

interface Props {
  pathname: string;
  sezony?: string[];
  aktualnaSezona?: string;
  seasonHrefTemplate?: string;
}
const { pathname, sezony, aktualnaSezona, seasonHrefTemplate } = Astro.props;

const nav = [
  { href: '/', label: 'Prehľad', match: (p: string) => p === '/' },
  { href: '/zvaz/sfz', label: 'Zväzy', match: (p: string) => p.startsWith('/zvaz') },
  { href: '/kluby', label: 'Kluby', match: (p: string) => p.startsWith('/kluby') || p.startsWith('/klub/') },
  { href: '/porovnania', label: 'Porovnania', match: (p: string) => p.startsWith('/porovnania') },
  { href: '/trendy', label: 'Trendy', match: (p: string) => p.startsWith('/trendy') },
  { href: '/demografia', label: 'Demografia', match: (p: string) => p.startsWith('/demografia') },
  { href: '/projekty', label: 'Projekty', match: (p: string) => p.startsWith('/projekty') },
  { href: '/dokumentacia', label: 'Dokumentácia', match: (p: string) => p.startsWith('/dokumentacia') },
];
const items = nav.map((n) => ({ href: n.href, label: n.label, aktivna: n.match(pathname) }));
const maPicker = sezony && sezony.length > 0 && aktualnaSezona;
---

<header
  class="sticky top-0 z-50 border-b border-line"
  style="background: rgba(255,255,255,.72); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);"
>
  <div class="mx-auto flex items-center flex-wrap justify-between gap-3" style="max-width:1240px; padding:12px 24px;">
    <a href="/" class="inline-flex items-center gap-3 no-underline" style="min-width:0;">
      <img src="/sfz-logo-official.svg" alt="SFZ" width="44" height="44" style="border-radius:9999px;" />
      <span class="inline-flex flex-col leading-none">
        <span class="font-display font-extrabold tracking-wide text-lg text-sfz-ink">ŠTATISTIKY</span>
        <span class="font-semibold tracking-[0.2em] text-[11px] text-sfz-blue">SLOVENSKÉHO FUTBALU</span>
      </span>
    </a>

    <!-- desktop nav -->
    <nav class="hidden md:flex items-center gap-1.5 text-sm">
      {
        items.map((it) => (
          <a
            href={it.href}
            class:list={[
              'rounded-[10px] px-3.5 py-2 font-bold transition-colors',
              it.aktivna
                ? 'bg-sfz-blue text-white'
                : 'text-ink hover:bg-black/[0.05]',
            ]}
          >
            {it.label}
          </a>
        ))
      }
      {
        maPicker && (
          <SeasonPicker
            client:load
            sezony={sezony}
            aktualna={aktualnaSezona}
            hrefTemplate={seasonHrefTemplate}
          />
        )
      }
    </nav>

    <!-- mobile: sezóna je teraz vnútri hamburgera (menej preplnená hlavička, panel sa neoreže) -->
    <div class="md:hidden flex items-center">
      <MobileMenu
        client:load
        polozky={items}
        sezony={maPicker ? sezony : undefined}
        aktualna={maPicker ? aktualnaSezona : undefined}
        hrefTemplate={seasonHrefTemplate}
      />
    </div>
  </div>
</header>
