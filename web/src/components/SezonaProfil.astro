---
// Sezónna stránka zväzu podľa design handoffu — pill úrovne, KPI karty s YoY,
// zápasy podľa kategórií (drill-down), osoby ako karty s rozpadom, veková pyramída.
// Zdieľané pre futbal (/zvaz/[id]/[sezona]) aj odvetvia (/zvaz/[id]/[odvetvie]/[sezona]).
import CategoryDrill from './CategoryDrill.tsx';
import ZvazPicker from './ZvazPicker.tsx';
import AgePyramid from './AgePyramid.tsx';
import { fmt, delta } from '../lib/format';
import { sezonyOdvetvia, odvetviaZvazu, ODVETVIE_LABEL, getZvazy, getDemografia, klubyZvazu } from '../lib/data';
import { GROUPS, REGION, RFZ_LABEL, RFZ_OF_GEONAME } from '../lib/palette';
import type { Profil, ZvazIndex } from '../lib/data';

interface Props {
  z: ZvazIndex;
  sezona: string;
  odvetvie: string;
  profil: Profil;
  predoslaSezona?: string;
  predosly?: Profil;
}
const { z, sezona, odvetvie, profil, predoslaSezona, predosly } = Astro.props;

const vsetkyZvazy = getZvazy().map((zz) => ({ id: zz.id, nazov: zz.nazov, uroven: zz.uroven, rfz: zz.rfz }));
const demo = odvetvie === 'futbal' ? getDemografia(z.id) : undefined;
const klubyPodZvazom = odvetvie === 'futbal' ? klubyZvazu(z.id).slice(0, 8) : [];
const klubyPocet = odvetvie === 'futbal' ? klubyZvazu(z.id).length : 0;

function sezonaUrl(o: string, s: string): string {
  const slug = s.replace('/', '-');
  return o === 'futbal' ? `/zvaz/${z.id}/${slug}` : `/zvaz/${z.id}/${o}/${slug}`;
}

const odvetvia = odvetviaZvazu(z);
const prepinacOdvetvi = odvetvia.map((o) => {
  const sez = sezonyOdvetvia(z, o);
  const ciel = sez.includes(sezona) ? sezona : sez[sez.length - 1];
  return { odvetvie: o, label: ODVETVIE_LABEL[o] ?? o, url: sezonaUrl(o, ciel) };
});

const hraci = (p: Profil) => p.osoby?.hraci?.unikatni ?? 0;
const kpiKarty = [
  { label: 'Súťaže', hodnota: profil.kpi.sutaze, predch: predosly?.kpi.sutaze, good: true },
  { label: 'Zápasy', hodnota: profil.kpi.zapasy, predch: predosly?.kpi.zapasy, good: true },
  { label: 'Družstvá', hodnota: profil.kpi.druzstva, predch: predosly?.kpi.druzstva, good: true },
  { label: 'Góly', hodnota: profil.kpi.goly, predch: predosly?.kpi.goly, good: true },
  { label: 'Diváci', hodnota: profil.kpi.divaci, predch: predosly?.kpi.divaci, good: true },
  { label: 'Žlté karty', hodnota: profil.kpi.zlteKarty, predch: predosly?.kpi.zlteKarty, good: false },
  { label: 'Červené karty', hodnota: profil.kpi.cerveneKarty, predch: predosly?.kpi.cerveneKarty, good: false },
].filter((k) => k.hodnota !== undefined) as { label: string; hodnota: number; predch?: number; good: boolean }[];

// osoby ako karty — unikátni + rozpad po 4 skupinách
const osobaLabel: Record<string, string> = {
  hraci: 'Hráči', treneri: 'Tréneri', realizacnyTim: 'Realizačný tím',
  rozhodcovia: 'Rozhodcovia', delegati: 'Delegáti', personal: 'Personál',
};
function rozpadSkupin(poKat: Record<string, number>) {
  return GROUPS.map((g) => ({
    key: g.key,
    color: g.color,
    hodnota: g.cats.reduce((s, c) => s + (poKat[c] ?? 0), 0),
  })).filter((r) => r.hodnota > 0);
}
const osobyKarty = Object.entries(profil.osoby)
  .filter(([, o]) => (o.unikatni ?? 0) > 0)
  .map(([rola, o]) => {
    const skupiny = rozpadSkupin(o.poKategorii ?? {});
    const max = Math.max(1, ...skupiny.map((s) => s.hodnota));
    return { rola, label: osobaLabel[rola] ?? rola, unikatni: o.unikatni, skupiny, max };
  });

const odvetvieLabel = ODVETVIE_LABEL[odvetvie] ?? odvetvie;
const urovenFarba: Record<string, string> = {
  SFZ: 'var(--color-sfz-blue)', RFZ: 'var(--color-good)', ObFZ: '#f0961b',
};
// Farba pilulky a názov regiónu (podľa vzoru): RFZ = vlastná farba, ObFZ = farba materského RFZ.
const regionId = z.uroven === 'RFZ' ? z.id : z.uroven === 'ObFZ' ? (RFZ_OF_GEONAME[z.rfz ?? ''] ?? '') : '';
const pilulkaFarba = REGION[regionId] ?? '#1450df';
const regionLabel = regionId ? RFZ_LABEL[regionId] : undefined;
const sezonyOdv = sezonyOdvetvia(z, odvetvie);
---

<p class="mb-3 text-sm"><a href="/" class="text-sfz-blue hover:underline">← Späť na mapu</a></p>

<header class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <span
      class="inline-block rounded-full px-3 py-0.5 text-xs font-bold uppercase tracking-wider"
      style={`background:${pilulkaFarba}1f; color:${pilulkaFarba};`}
    >
      {z.uroven}
    </span>
    <h1 class="mt-2 font-extrabold tracking-tight" style="font-size:clamp(28px,4.4vw,48px); line-height:1.05;">
      {z.nazov}
    </h1>
    {regionLabel && <p class="mt-1 text-sm text-muted">Región: {regionLabel}</p>}
    {
      prepinacOdvetvi.length > 1 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {prepinacOdvetvi.map((o) => (
            <a
              href={o.url}
              class:list={[
                'rounded-full border px-3 py-0.5 text-sm',
                o.odvetvie === odvetvie
                  ? 'border-sfz-blue bg-sfz-blue text-white font-semibold'
                  : 'border-black/10 text-sfz-blue hover:bg-black/5',
              ]}
            >
              {o.label}
            </a>
          ))}
        </div>
      )
    }
  </div>
  <div>
    <div class="text-xs font-semibold uppercase tracking-wider text-muted mb-1 text-right">Vybrať iný zväz</div>
    <ZvazPicker client:load zvazy={vsetkyZvazy} aktualne={z.id} />
  </div>
</header>


<!-- KPI karty (bez ikon, s medziročne) -->
<section class="grid gap-3.5" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr));">
  {
    kpiKarty.map((k) => {
      const d = delta(k.hodnota, k.predch, k.good);
      return (
        <div class="border border-line" style="background:var(--color-card); border-radius:16px; padding:16px; box-shadow:var(--shadow-card); container-type:inline-size;">
          <div class="text-[11px] font-bold uppercase tracking-wider text-muted">{k.label}</div>
          <div class="tnum mt-1.5 font-extrabold" style="font-size:clamp(20px,16cqi,30px); line-height:1.05; white-space:nowrap;">{fmt(k.hodnota)}</div>
          {d && (
            <div class="mt-1 text-xs">
              <span class="tnum font-semibold" style={`color:${d.color};`}>{d.arrow} {d.text}</span>
              <span class="text-muted"> medziročne</span>
            </div>
          )}
        </div>
      );
    })
  }
</section>
{predoslaSezona && <p class="mt-2 text-xs text-muted">Medziročná zmena oproti sezóne {predoslaSezona}.</p>}

<!-- zápasy podľa kategórií -->
<section class="mt-8 border border-line" style="background:var(--color-card); border-radius:16px; padding:18px; box-shadow:var(--shadow-card);">
  <div class="text-xs font-bold uppercase tracking-[0.14em] text-sfz-blue">Vekové kategórie</div>
  <h2 class="font-extrabold" style="font-size:20px; margin:2px 0 2px;">Zápasy podľa kategórií</h2>
  <p class="text-sm text-muted mb-3">Klikni na kategóriu pre rozpad na konkrétne vekové úrovne.</p>
  <CategoryDrill client:visible kategorie={profil.kategorie} />
</section>

<!-- osoby ako karty -->
<section class="mt-8">
  <div class="text-xs font-bold uppercase tracking-[0.14em] text-sfz-blue">Osoby v súťažiach</div>
  <h2 class="font-extrabold" style="font-size:20px; margin:2px 0 6px;">Ľudia v zväze</h2>
  <p class="text-sm text-muted mb-4">
    Unikátne osoby podľa úlohy a vekovej kategórie. Súčet po kategóriách môže prevyšovať počet
    unikátnych osôb (viacnásobné pôsobenie).
  </p>
  <div class="grid gap-3.5" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr));">
    {
      osobyKarty.map((o) => (
        <div class="border border-line" style="background:var(--color-card); border-radius:16px; padding:16px; box-shadow:var(--shadow-card);">
          <div class="text-[11px] font-bold uppercase tracking-wider text-muted">{o.label}</div>
          <div class="tnum text-3xl font-extrabold mt-0.5">{fmt(o.unikatni)}</div>
          <div class="mt-3 flex flex-col gap-1.5">
            {o.skupiny.map((s) => (
              <div class="flex items-center gap-2 text-xs">
                <span style={`color:${s.color}; width:64px;`}>{s.key}</span>
                <span class="flex-1 h-2 rounded-full" style="background:var(--color-track);">
                  <span class="block h-full rounded-full" style={`width:${(s.hodnota / o.max) * 100}%; background:${s.color};`} />
                </span>
                <span class="tnum text-right" style="width:52px;">{fmt(s.hodnota)}</span>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<!-- veková pyramída -->
{
  demo && (
    <section class="mt-8 border border-line" style="background:var(--color-card); border-radius:16px; padding:18px; box-shadow:var(--shadow-card);">
      <div class="text-xs font-bold uppercase tracking-[0.14em] text-sfz-blue">Veková štruktúra</div>
      <h2 class="font-extrabold" style="font-size:20px; margin:2px 0 2px;">Veková pyramída</h2>
      <p class="text-sm text-muted mb-3">Registrované osoby podľa veku a pohlavia v sezóne {sezona}. Prepni rolu.</p>
      <AgePyramid client:visible demo={demo} sezona={sezona} />
    </section>
  )
}

{
  klubyPocet > 0 && (
    <section class="mt-8 border border-line" style="background:var(--color-card); border-radius:16px; padding:18px; box-shadow:var(--shadow-card);">
      <div class="text-xs font-bold uppercase tracking-[0.14em] text-sfz-blue">Kluby</div>
      <h2 class="font-extrabold" style="font-size:20px; margin:2px 0 2px;">Kluby v tomto zväze</h2>
      <p class="text-sm text-muted mb-3">{klubyPocet} klubov s odohraným zápasom pod týmto zväzom.</p>
      <div class="flex flex-wrap gap-1.5">
        {klubyPodZvazom.map((k) => (
          <a href={k.sezony?.length ? `/klub/${k.id}/${k.sezony[k.sezony.length - 1].replace('/', '-')}` : `/klub/${k.id}`} class="rounded-full border border-black/10 px-3 py-0.5 text-sm text-sfz-blue hover:bg-black/5">{k.nazov}</a>
        ))}
        <a href="/kluby" class="rounded-full border border-sfz-blue bg-sfz-blue text-white px-3 py-0.5 text-sm font-semibold">Všetky kluby →</a>
      </div>
    </section>
  )
}

<p class="mt-8 text-xs text-muted">
  <b>Metodika:</b> započítané sú len uzavreté zápasy (closed). Góly a karty z udalostí v zápisoch;
  diváci z vyplnených protokolov (pokrytie {Math.round(((profil.methodologyFlags?.divaciPokrytie as number) ?? 0) * 100)} %).
  Súčet osôb po kategóriách môže prevyšovať počet unikátnych osôb. Dáta generované {profil.generatedAt}.
</p>
