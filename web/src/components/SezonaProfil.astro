---
// Zdieľaný obsah sezónnej stránky zväzu — KPI s medziročným porovnaním,
// graf kategórií, pohlavie a osoby. Používa sa pre futbal (/zvaz/[id]/[sezona])
// aj ďalšie odvetvia (/zvaz/[id]/[odvetvie]/[sezona], napr. futsal — §10).
import CategoryDrill from './CategoryDrill.tsx';
import ZvazPicker from './ZvazPicker.tsx';
import Ikona from './Ikona.astro';
import { fmt, sezonyOdvetvia, odvetviaZvazu, ODVETVIE_LABEL, getZvazy } from '../lib/data';
import type { Profil, ZvazIndex } from '../lib/data';

const vsetkyZvazy = getZvazy().map((zz) => ({ id: zz.id, nazov: zz.nazov, uroven: zz.uroven, rfz: zz.rfz }));

interface Props {
  z: ZvazIndex;
  sezona: string;
  odvetvie: string; // 'futbal' | 'futsal' | …
  profil: Profil;
  predoslaSezona?: string;
  predosly?: Profil;
}
const { z, sezona, odvetvie, profil, predoslaSezona, predosly } = Astro.props;

/** URL sezónnej stránky pre odvetvie (futbal je bez segmentu odvetvia). */
function sezonaUrl(o: string, s: string): string {
  const slug = s.replace('/', '-');
  return o === 'futbal' ? `/zvaz/${z.id}/${slug}` : `/zvaz/${z.id}/${o}/${slug}`;
}

// prepínač odvetvia: pri prepnutí ostaň na rovnakej sezóne, ak ju odvetvie má,
// inak skoč na jeho najnovšiu sezónu
const odvetvia = odvetviaZvazu(z);
const prepinacOdvetvi = odvetvia.map((o) => {
  const sez = sezonyOdvetvia(z, o);
  const ciel = sez.includes(sezona) ? sezona : sez[sez.length - 1];
  return { odvetvie: o, label: ODVETVIE_LABEL[o] ?? o, url: sezonaUrl(o, ciel) };
});

const hraci = (p: Profil) => p.osoby?.hraci?.unikatni ?? 0;
const kpiKarty = [
  { ikona: 'sutaze', label: 'Súťaže', hodnota: profil.kpi.sutaze, predch: predosly?.kpi.sutaze },
  { ikona: 'druzstva', label: 'Družstvá', hodnota: profil.kpi.druzstva, predch: predosly?.kpi.druzstva },
  { ikona: 'zapasy', label: 'Zápasy', hodnota: profil.kpi.zapasy, predch: predosly?.kpi.zapasy },
  { ikona: 'goly', label: 'Góly', hodnota: profil.kpi.goly, predch: predosly?.kpi.goly },
  { ikona: 'hraci', label: 'Hráči', hodnota: hraci(profil), predch: predosly ? hraci(predosly) : undefined },
  { ikona: 'divaci', label: 'Diváci', hodnota: profil.kpi.divaci, predch: predosly?.kpi.divaci },
  { ikona: 'zlteKarty', label: 'Žlté karty', hodnota: profil.kpi.zlteKarty, predch: predosly?.kpi.zlteKarty },
  { ikona: 'cerveneKarty', label: 'Červené karty', hodnota: profil.kpi.cerveneKarty, predch: predosly?.kpi.cerveneKarty },
].filter((k) => k.hodnota !== undefined) as {
  ikona: string;
  label: string;
  hodnota: number;
  predch?: number;
}[];

// rozpis po vekových kategóriách (dáta už v profil.kategorie)
const katPoradie = Object.keys(profil.kategorie);
const katRiadky = katPoradie.map((cat) => ({ cat, ...profil.kategorie[cat] }));

// osoby po kategóriách (profil.osoby.{rola}.poKategorii) — tabuľka rola × kategória
const osobyRoly = [
  { key: 'hraci', label: 'Hráči' },
  { key: 'treneri', label: 'Tréneri' },
  { key: 'rozhodcovia', label: 'Rozhodcovia' },
  { key: 'delegati', label: 'Delegáti' },
  { key: 'personal', label: 'Personál' },
].filter((r) => (profil.osoby[r.key]?.unikatni ?? 0) > 0);
const maKategorie = katPoradie.length > 0;

/** Medziročná zmena: smer (▲/▼), percento a farba (rast zelená, pokles červená). */
function delta(hodnota: number, predch?: number) {
  if (predch === undefined || predch === 0) return null;
  const rozdiel = hodnota - predch;
  if (rozdiel === 0) return { sipka: '→', text: '0 %', trieda: 'text-sfz-muted' };
  const pct = Math.round((rozdiel / predch) * 100);
  if (pct === 0) return { sipka: '→', text: '≈ 0 %', trieda: 'text-sfz-muted' };
  return {
    sipka: rozdiel > 0 ? '▲' : '▼',
    text: `${rozdiel > 0 ? '+' : ''}${pct} %`,
    trieda: rozdiel > 0 ? 'text-emerald-600' : 'text-sfz-red',
  };
}

// pohlavie
interface PohlavieBlok {
  zapasy: number;
  druzstva: number;
  goly: number;
  divaci: number;
  zlteKarty: number;
  cerveneKarty: number;
}
const pohlavieLabel: Record<string, string> = { M: 'Muži', F: 'Ženy', NEURCENE: 'Neurčené' };
const pohlavie = profil.pohlavie as Record<string, PohlavieBlok>;
const pohlavieRiadky = Object.entries(pohlavie).map(([g, b]) => ({
  label: pohlavieLabel[g] ?? g,
  ...b,
}));

// osoby
const osobaLabel: Record<string, string> = {
  hraci: 'Hráči',
  treneri: 'Tréneri',
  rozhodcovia: 'Rozhodcovia',
  delegati: 'Delegáti',
  personal: 'Personál',
};
const osobyRiadky = Object.entries(profil.osoby).map(([rola, o]) => ({
  ikona: rola,
  label: osobaLabel[rola] ?? rola,
  unikatni: o.unikatni,
}));

const sezonyDesc = sezonyOdvetvia(z, odvetvie).slice().reverse();
const odvetvieLabel = ODVETVIE_LABEL[odvetvie] ?? odvetvie;
---

<p class="mb-2 text-sm">
  <a href={`/zvaz/${z.id}`} class="text-sfz-blue hover:underline">← {z.nazov}</a>
</p>

<header class="mb-6">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <div class="text-xs font-semibold uppercase tracking-wider text-muted">
        {z.uroven} · {odvetvieLabel.toLowerCase()}
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight">{z.nazov}</h1>
    </div>
    <ZvazPicker client:load zvazy={vsetkyZvazy} aktualne={z.id} />
  </div>

  {
    prepinacOdvetvi.length > 1 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        <span class="text-sm text-sfz-muted mr-1 self-center">Odvetvie:</span>
        {prepinacOdvetvi.map((o) => (
          <a
            href={o.url}
            class:list={[
              'rounded-md border px-2 py-0.5 text-sm',
              o.odvetvie === odvetvie
                ? 'border-sfz-blue bg-sfz-blue text-white font-semibold'
                : 'border-black/10 text-sfz-blue hover:bg-black/5',
            ]}
          >
            {o.label}
          </a>
        ))}
      </div>
    )
  }

  <div class="mt-3 flex flex-wrap gap-1.5">
    {
      sezonyDesc.map((s) => (
        <a
          href={sezonaUrl(odvetvie, s)}
          class:list={[
            'rounded-md border px-2 py-0.5 text-sm',
            s === sezona
              ? 'border-sfz-blue bg-sfz-blue text-white font-semibold'
              : 'border-black/10 text-sfz-blue hover:bg-black/5',
          ]}
        >
          {s}
        </a>
      ))
    }
  </div>
</header>

<section class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
  {
    kpiKarty.map((k) => {
      const d = delta(k.hodnota, k.predch);
      return (
        <div class="rounded-xl border border-black/10 p-4">
          <div class="text-sfz-blue mb-1.5">
            <Ikona name={k.ikona} class="w-5 h-5" />
          </div>
          <div class="text-2xl font-extrabold tabular-nums">{fmt(k.hodnota)}</div>
          <div class="text-sm text-sfz-muted">{k.label}</div>
          {d && (
            <div class:list={['mt-1 text-xs font-medium tabular-nums', d.trieda]}>
              {d.sipka} {d.text}
            </div>
          )}
        </div>
      );
    })
  }
</section>
{
  predoslaSezona && (
    <p class="mt-2 text-xs text-sfz-muted">Medziročná zmena oproti sezóne {predoslaSezona}.</p>
  )
}

<section class="mt-10">
  <h2 class="text-lg font-bold mb-3">Zápasy podľa vekových kategórií</h2>
  <CategoryDrill client:visible kategorie={profil.kategorie} />

  {
    maKategorie && (
      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="text-left text-sfz-muted border-b border-black/10">
              <th class="py-1 pr-4 font-medium">Kategória</th>
              <th class="py-1 px-2 font-medium text-right">Zápasy</th>
              <th class="py-1 px-2 font-medium text-right">Družstvá</th>
              <th class="py-1 px-2 font-medium text-right">Góly</th>
              <th class="py-1 px-2 font-medium text-right">Góly/zápas</th>
              <th class="py-1 px-2 font-medium text-right">Diváci</th>
              <th class="py-1 px-2 font-medium text-right">Žlté</th>
              <th class="py-1 px-2 font-medium text-right">Červené</th>
            </tr>
          </thead>
          <tbody>
            {katRiadky.map((r) => (
              <tr class="border-b border-black/5">
                <td class="py-1 pr-4 font-medium">{r.cat}</td>
                <td class="py-1 px-2 text-right tabular-nums">{fmt(r.zapasy)}</td>
                <td class="py-1 px-2 text-right tabular-nums">{fmt(r.druzstva)}</td>
                <td class="py-1 px-2 text-right tabular-nums">{fmt(r.goly)}</td>
                <td class="py-1 px-2 text-right tabular-nums">
                  {r.zapasy ? (r.goly / r.zapasy).toFixed(2) : '—'}
                </td>
                <td class="py-1 px-2 text-right tabular-nums">{fmt(r.divaci)}</td>
                <td class="py-1 px-2 text-right tabular-nums">{fmt(r.zlte)}</td>
                <td class="py-1 px-2 text-right tabular-nums">{fmt(r.cervene)}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="mt-2 text-xs text-sfz-muted">
          Góly a karty z udalostí v zápisoch o stretnutí; diváci z vyplnených protokolov (pokrytie
          {' '}
          {Math.round(((profil.methodologyFlags?.divaciPokrytie as number) ?? 0) * 100)} %). Družstvá
          = unikátne kluby s ≥ 1 odohraným zápasom.
        </p>
      </div>
    )
  }
</section>

<div class="mt-10 grid gap-8 md:grid-cols-2">
  <section>
    <h2 class="text-lg font-bold mb-3">Pohlavie</h2>
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="text-left text-sfz-muted border-b border-black/10">
          <th class="py-1 font-medium">Skupina</th>
          <th class="py-1 font-medium text-right">Zápasy</th>
          <th class="py-1 font-medium text-right">Družstvá</th>
          <th class="py-1 font-medium text-right">Góly</th>
        </tr>
      </thead>
      <tbody>
        {
          pohlavieRiadky.map((r) => (
            <tr class="border-b border-black/5">
              <td class="py-1">{r.label}</td>
              <td class="py-1 text-right tabular-nums">{fmt(r.zapasy)}</td>
              <td class="py-1 text-right tabular-nums">{fmt(r.druzstva)}</td>
              <td class="py-1 text-right tabular-nums">{fmt(r.goly)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section>
    <h2 class="text-lg font-bold mb-3">Osoby (unikátne)</h2>
    <table class="w-full text-sm border-collapse">
      <tbody>
        {
          osobyRiadky.map((r) => (
            <tr class="border-b border-black/5">
              <td class="py-1 flex items-center gap-2">
                <span class="text-sfz-blue"><Ikona name={r.ikona} class="w-4 h-4" /></span>
                {r.label}
              </td>
              <td class="py-1 text-right tabular-nums">{fmt(r.unikatni)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="mt-2 text-xs text-sfz-muted">
      Súčet po kategóriách môže prevýšiť počet unikátnych osôb (dvojité pôsobenie).
    </p>
  </section>
</div>

{
  maKategorie && osobyRoly.length > 0 && (
    <section class="mt-10">
      <h2 class="text-lg font-bold mb-3">Osoby podľa vekových kategórií</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="text-left text-sfz-muted border-b border-black/10">
              <th class="py-1 pr-4 font-medium">Rola</th>
              {katPoradie.map((cat) => (
                <th class="py-1 px-2 font-medium text-right">{cat}</th>
              ))}
              <th class="py-1 px-2 font-medium text-right">Unikátne</th>
            </tr>
          </thead>
          <tbody>
            {osobyRoly.map((rola) => {
              const o = profil.osoby[rola.key];
              return (
                <tr class="border-b border-black/5">
                  <td class="py-1 pr-4 flex items-center gap-2">
                    <span class="text-sfz-blue"><Ikona name={rola.key} class="w-4 h-4" /></span>
                    {rola.label}
                  </td>
                  {katPoradie.map((cat) => (
                    <td class="py-1 px-2 text-right tabular-nums">
                      {o.poKategorii[cat] ? fmt(o.poKategorii[cat]) : '—'}
                    </td>
                  ))}
                  <td class="py-1 px-2 text-right tabular-nums font-semibold">{fmt(o.unikatni)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-xs text-sfz-muted">
        Tá istá osoba môže pôsobiť vo viacerých kategóriách, preto súčet po kategóriách býva vyšší
        než počet unikátnych osôb. Historické sezóny nemusia mať priradenú kategóriu ku každej osobe.
      </p>
    </section>
  )
}

<p class="mt-10 text-xs text-sfz-muted">Dáta generované {profil.generatedAt} · len uzavreté zápasy.</p>
