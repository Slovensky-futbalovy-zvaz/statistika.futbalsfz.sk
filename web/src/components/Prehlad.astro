---
import Base from '../layouts/Base.astro';
import KpiTrend from './KpiTrend.tsx';
import SlovakiaMap from './SlovakiaMap.tsx';
import SunburstSutaze from './SunburstSutaze.tsx';
import SunburstOsoby from './SunburstOsoby.tsx';
import PyramidaSutazi from './PyramidaSutazi.tsx';
import AgePyramid from './AgePyramid.tsx';
import { getSumarSezony, getSumar, getMapData, getSumarDemografia, demoTrend, fmt, ODVETVIE_LABEL } from '../lib/data';
import { delta } from '../lib/format';

const sezony = getSumarSezony();
const sumreMap = new Map(sezony.map((s) => [s, getSumar(s)]));
const trendSezony = sezony;
const trendPerSeason: Record<string, any> = {};
for (const s of sezony) trendPerSeason[s] = ((sumreMap.get(s) as any)?.kategorie) ?? {};
// rozpad ďalších odvetví (futsal, …) po vekových úrovniach — pill filter športu v trende
const trendOdvetvia: Record<string, Record<string, any>> = {};
for (const s of sezony) {
  const odv = ((sumreMap.get(s) as any)?.odvetvia ?? {}) as Record<string, any>;
  for (const [sektor, blok] of Object.entries(odv)) {
    if (!blok?.kategorie || Object.keys(blok.kategorie).length === 0) continue;
    (trendOdvetvia[sektor] ??= {})[s] = blok.kategorie;
  }
}
const trendOsoby = demoTrend(getSumarDemografia());

interface Props {
  sezona: string;
}
const { sezona } = Astro.props;
const aktualna = sezona;
const idx = sezony.indexOf(aktualna);
const predosla = idx > 0 ? sezony[idx - 1] : undefined;
const sumar = sumreMap.get(aktualna)!;
const sumarPrev = predosla ? sumreMap.get(predosla) : undefined;

// pyramída líg (etapa 2) — rozpad úroveň × veková kategória × pohlavie za celú SR
const pyramidaRiadky = sumar.sutazeUroven ?? [];
const pyramidaOdvetvia: Record<string, typeof pyramidaRiadky> = {};
for (const [sektor, blok] of Object.entries(sumar.odvetvia ?? {})) {
  const r = blok?.sutazeUroven ?? [];
  if (r.length) pyramidaOdvetvia[sektor] = r;
}

function spolu(s: ReturnType<typeof getSumar> | undefined, k: string): number {
  if (!s) return 0;
  let v = (s.kpi as Record<string, number>)[k] ?? 0;
  for (const o of Object.values(s.odvetvia)) v += (o.kpi as Record<string, number>)[k] ?? 0;
  return v;
}
const kpiKarty = [
  { key: 'sutaze', label: 'Súťaže', good: true },
  { key: 'zapasy', label: 'Odohraté zápasy', good: true },
  { key: 'druzstva', label: 'Družstvá', good: true },
  { key: 'goly', label: 'Strelené góly', good: true },
  { key: 'divaci', label: 'Diváci', good: true },
  { key: 'zlteKarty', label: 'Žlté karty', good: false },
  { key: 'cerveneKarty', label: 'Červené karty', good: false },
].map((k) => ({
  ...k,
  hodnota: spolu(sumar, k.key),
  d: delta(spolu(sumar, k.key), sumarPrev ? spolu(sumarPrev, k.key) : undefined, k.good),
}));

function osobySpolu(s: ReturnType<typeof getSumar>, rola: string): number {
  let v = (s.osoby as Record<string, number>)[rola] ?? 0;
  for (const o of Object.values(s.odvetvia)) v += (o.osoby as Record<string, number>)[rola] ?? 0;
  return v;
}
const roly = [
  { key: 'hraci', label: 'Hráči' },
  { key: 'treneri', label: 'Tréneri' },
  { key: 'rozhodcovia', label: 'Rozhodcovia' },
  { key: 'delegati', label: 'Delegáti' },
  { key: 'personal', label: 'Personál' },
];
const osobyKarty = roly.map((r) => {
  const trend = sezony.map((s) => osobySpolu(sumreMap.get(s)!, r.key));
  const hodnota = osobySpolu(sumar, r.key);
  const prev = sumarPrev ? osobySpolu(sumarPrev, r.key) : undefined;
  const mn = Math.min(...trend), mx = Math.max(...trend);
  const pts = trend
    .map((v, i) => {
      const x = (i / (trend.length - 1 || 1)) * 100;
      const y = 26 - ((v - mn) / (mx - mn || 1)) * 22 - 2;
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(' ');
  return { ...r, hodnota, d: delta(hodnota, prev, true), pts };
});

const mapData = getMapData(aktualna);
const srDemo = getSumarDemografia();

// SEO: popis + FAQ (viditeľné aj ako FAQPage structured data)
const popis = `Slovenský futbal v číslach za sezónu ${aktualna}: ${fmt(kpiKarty[1]?.hodnota ?? 0)} odohraných zápasov, ${fmt(kpiKarty[3]?.hodnota ?? 0)} gólov a ${fmt(kpiKarty[4]?.hodnota ?? 0)} divákov naprieč SFZ, 4 regionálnymi (RFZ) a 38 oblastnými (ObFZ) zväzmi. Interaktívna mapa, rebríčky, demografia a projekty.`;
const faq = [
  {
    q: 'Čo je portál Štatistiky slovenského futbalu?',
    a: 'Verejný štatistický portál Slovenského futbalového zväzu (SFZ), ktorý prehľadne sprístupňuje čísla o slovenskom futbale — zápasy, góly, diváci, karty, kluby aj registrované osoby — na všetkých troch úrovniach pyramídy: SFZ, 4 regionálne (RFZ) a 38 oblastných (ObFZ) zväzov.',
  },
  {
    q: 'Odkiaľ pochádzajú dáta?',
    a: 'Dáta pochádzajú z platformy <a href="https://sportnet.online" target="_blank" rel="noopener" style="color:var(--color-sfz-blue)">sportnet.online</a>, ktorá eviduje súťaže, zápasy a osoby slovenského futbalu. Publikujú sa výhradne agregované počty; portál neuvádza mená osôb.',
  },
  {
    q: 'Aké súťaže a zväzy portál pokrýva?',
    a: 'Pokrýva približne 400 súťaží riadených SFZ, regionálnymi a oblastnými zväzmi — futbal aj futsal, všetky vekové kategórie (dospelí, dorast, žiaci, prípravky) a obe pohlavia.',
  },
  {
    q: 'Ako sa počítajú zápasy a diváci?',
    a: 'Do „Odohratých zápasov" sa započítavajú len reálne odohrané zápasy so zápisom o stretnutí. Administratívne ukončené zápasy (kontumácia alebo odstúpené družstvo bez odohratia — bez udalostí v zápise, bez divákov a bez podanej zostavy) sa nezapočítavajú. Diváci vychádzajú z vyplnených zápisov, preto je pri nich uvedené percentuálne pokrytie. Podrobnosti v sekcii Dokumentácia.',
  },
  {
    q: 'Sú kontumované zápasy započítané do počtu zápasov?',
    a: 'Rozlišujeme. Reálne odohraný zápas, ktorý bol dodatočne kontumovaný, sa započítava. Administratívna kontumácia alebo odstúpené družstvo bez odohratia (technický výsledok, bez udalostí, bez divákov a bez podanej zostavy) sa do „Odohratých zápasov" nezapočítava. Ich počty sú samostatne v doplnkových kartách „Kontumované" a „Odstúpené". Podrobná metodika je v sekcii Dokumentácia.',
  },
  {
    q: 'Čo znamená „sezóna" 2025/2026?',
    a: 'Súťažná sezóna trvá od 1. júla jedného roka do 30. júna nasledujúceho roka, preto sa označuje v tvare rok/rok, napríklad 2025/2026.',
  },
  {
    q: 'Kde nájdem podrobnú metodiku výpočtov?',
    a: 'V sekcii Dokumentácia (v hlavnom menu) — obsahuje zdroj dát, definície ukazovateľov a presné pravidlá, napríklad ako sa počítajú odohraté zápasy a ako sa nakladá s kontumáciami a odstúpenými družstvami.',
  },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const KICKER = 'text-xs font-bold uppercase tracking-[0.14em] text-sfz-blue';
const H2 = 'font-extrabold tracking-tight';
const CARD = 'border border-line';
const CARD_STYLE = 'background:var(--color-card); border-radius:16px; padding:18px; box-shadow:var(--shadow-card);';
---

<Base
  description={popis}
  image="/og/prehlad.png"
  keywords="štatistiky slovenský futbal, SFZ, RFZ, ObFZ, futbalové štatistiky, zápasy, góly, diváci, kluby, futbalová pyramída"
  jsonLd={[faqLd]}
  sezony={sezony}
  aktualnaSezona={aktualna}
  seasonHrefTemplate="/prehlad/{sezona}"
>
  <!-- Hero -->
  <section class="relative overflow-hidden text-white" style="border-radius:20px; padding:clamp(26px,4vw,46px); background:linear-gradient(120deg,#0a2a8f,#1450df 60%,#2f6bff);">
    <div aria-hidden="true" style="position:absolute; right:-80px; top:-80px; width:320px; height:320px; border-radius:9999px; background:radial-gradient(circle,rgba(255,255,255,.25),transparent 70%);"></div>
    <div class="relative">
      <span class="inline-block rounded-full px-3 py-1 text-xs font-bold uppercase tracking-[0.12em]" style="background:rgba(255,255,255,.16);">
        Sezóna {aktualna} · celé Slovensko
      </span>
      <h1 class="font-display mt-3 font-extrabold" style="font-size:clamp(28px,4.6vw,52px); line-height:1.05;">Slovenský futbal v číslach</h1>
      <p class="mt-3 max-w-2xl text-white/85" style="font-size:15px;">
        Interaktívny prehľad všetkých troch úrovní futbalovej pyramídy — SFZ, 4 regionálne a 38
        oblastných zväzov. Klikni do mapy a preskúmaj svoj región.
      </p>
    </div>
  </section>

  <!-- KPI band (bez ikon, s medziročne) -->
  <section class="mt-8 grid gap-3.5" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr));">
    {
      kpiKarty.map((k) => (
        <div class={CARD} style={CARD_STYLE + ' container-type:inline-size;'}>
          <div class="text-[11px] font-bold uppercase tracking-wider text-muted">{k.label}</div>
          <div class="tnum mt-1.5 font-extrabold" style="font-size:clamp(20px,17cqi,32px); line-height:1.05; white-space:nowrap;">{fmt(k.hodnota)}</div>
          {k.d && (
            <div class="mt-1 text-xs">
              <span class="tnum font-semibold" style={`color:${k.d.color};`}>{k.d.arrow} {k.d.text}</span>
              <span class="text-muted"> medziročne</span>
            </div>
          )}
        </div>
      ))
    }
  </section>

  <!-- Mapa + rebríček (dve samostatné karty) -->
  <section class="mt-10">
    <SlovakiaMap client:load mapData={mapData} />
  </section>

  <!-- Osoby vo futbale -->
  <section class="mt-10">
    <div class={KICKER}>Osoby vo futbale</div>
    <h2 class={H2} style="font-size:clamp(21px,2.4vw,28px); margin:2px 0 4px;">Ľudia okolo lopty</h2>
    <p class="text-sm text-muted mb-4">
      Unikátne registrované osoby v jednotlivých úlohách za sezónu {aktualna} a ich vývoj za {sezony.length} sezón.
    </p>
    <div class="grid gap-3.5" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr));">
      {
        osobyKarty.map((o) => (
          <div class={CARD} style={CARD_STYLE}>
            <div class="text-[11px] font-bold uppercase tracking-wider text-muted">{o.label}</div>
            <div class="tnum mt-0.5 text-3xl font-extrabold">{fmt(o.hodnota)}</div>
            {o.d && (
              <div class="mt-0.5 text-xs">
                <span class="tnum font-semibold" style={`color:${o.d.color};`}>{o.d.arrow} {o.d.text}</span>
                <span class="text-muted"> medziročne</span>
              </div>
            )}
            <svg viewBox="0 0 100 26" preserveAspectRatio="none" class="mt-2 w-full" style="height:30px;">
              <polyline points={o.pts} fill="none" stroke="var(--color-sfz-blue)" stroke-width="1.6" vector-effect="non-scaling-stroke" />
            </svg>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Celoslovenský súhrn — sunbursty -->
  <section class="mt-10">
    <div class={KICKER}>Celoslovenský súhrn</div>
    <h2 class={H2} style="font-size:clamp(21px,2.4vw,28px); margin:2px 0 4px;">Kde sa hrajú zápasy a kto ich tvorí</h2>
    <p class="text-sm text-muted mb-4">
      Dva pohľady na celý slovenský futbal — geografická štruktúra súťaží a rozdelenie osôb podľa rolí a veku.
    </p>
    <div class="grid gap-6 lg:grid-cols-2">
      <div class={CARD} style={CARD_STYLE}>
        <div class={KICKER}>Súťaže — štruktúra pyramídy</div>
        <p class="text-sm text-muted mt-1 mb-2">Zápasy podľa odvetvia a riadiaceho zväzu (SFZ → RFZ → ObFZ).</p>
        <SunburstSutaze client:visible strom={sumar.sunburstSutaze} />
      </div>
      <div class={CARD} style={CARD_STYLE}>
        <div class={KICKER}>Osoby — úroveň, rola a vek</div>
        <p class="text-sm text-muted mt-1 mb-2">Osoby podľa odvetvia → úrovne (SFZ/RFZ/ObFZ) → roly → vekovej úrovne.</p>
        <SunburstOsoby client:visible strom={sumar.sunburstOsoby} />
      </div>
    </div>
  </section>

  <!-- Počet súťaží podľa úrovne (pyramída líg) -->
  {
    pyramidaRiadky.length > 0 && (
      <section class="mt-10">
        <div class={KICKER}>Počet súťaží</div>
        <h2 class={H2} style="font-size:clamp(21px,2.4vw,28px); margin:2px 0 4px;">
          Pyramídy líg podľa vekových kategórií
        </h2>
        <p class="text-sm text-muted mb-4">
          Koľko súťaží sa hrá na jednotlivých úrovniach — od najvyššej celoštátnej po najnižšie
          oblastné. Každá veková kategória má vlastnú pyramídu, pretože „1. liga“ dospelých,
          dorastencov a žiakov sú tri rôzne súťaže. V každej sa dá rozbaliť konkrétna veková úroveň.
        </p>
        <div class={CARD} style={CARD_STYLE}>
          <PyramidaSutazi
            client:visible
            riadky={pyramidaRiadky}
            odvetvia={pyramidaOdvetvia}
            odvetvieLabel={ODVETVIE_LABEL}
          />
        </div>
      </section>
    )
  }

  <!-- Veková pyramída SR -->
  {
    srDemo && (
      <section class="mt-10">
        <div class={CARD} style={CARD_STYLE}>
          <div class={KICKER}>Veková štruktúra SR</div>
          <h2 class={H2} style="font-size:20px; margin:2px 0 2px;">Veková pyramída — celé Slovensko</h2>
          <p class="text-sm text-muted mb-3">
            Všetky registrované osoby podľa veku a pohlavia, súčet všetkých zväzov, sezóna {aktualna}. Prepni rolu.
          </p>
          <AgePyramid client:visible demo={srDemo} sezona={aktualna} />
        </div>
      </section>
    )
  }

  <!-- Vývoj v čase (SR) -->
  <section class="mt-10">
    <div class={CARD} style={CARD_STYLE}>
      <div class={KICKER}>15-ročný trend · vekové úrovne</div>
      <h2 class={H2} style="font-size:clamp(21px,2.4vw,28px); margin:2px 0 6px;">Súťaže a zápasy vo futbale na Slovensku</h2>
      <p class="text-sm text-muted mb-3">Počet súťaží a reálne odohrané zápasy (a góly, diváci, karty, družstvá) naprieč sezónami, súčet 43 zväzov. Prepni metriku, šport a vekové skupiny.</p>
      <KpiTrend client:visible sezony={trendSezony} perSeason={trendPerSeason} perSeasonOsoby={trendOsoby} perSeasonOdvetvia={trendOdvetvia} odvetvieLabel={ODVETVIE_LABEL} />
    </div>
  </section>

  <!-- O portáli + FAQ (SEO + AI) -->
  <section class="mt-12">
    <div class={KICKER}>O portáli</div>
    <h2 class={H2} style="font-size:clamp(21px,2.4vw,28px); margin:2px 0 8px;">Často kladené otázky</h2>
    <p class="text-muted mb-6 max-w-3xl">
      <strong class="text-ink">Štatistiky slovenského futbalu</strong> sú verejný portál Slovenského
      futbalového zväzu. Prehľadne sprístupňujú čísla o slovenskom futbale na všetkých troch úrovniach
      pyramídy — SFZ, štyri regionálne (RFZ) a 38 oblastných (ObFZ) zväzov — za jednotlivé sezóny.
      Zdrojom dát je platforma <a href="https://sportnet.online" target="_blank" rel="noopener" class="text-sfz-blue hover:underline">sportnet.online</a>; publikujú sa výhradne agregované počty.
    </p>
    <div class="grid gap-3.5" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr));">
      {
        faq.map((f) => (
          <div class={CARD} style={CARD_STYLE}>
            <h3 class="font-bold text-ink" style="font-size:15px;">{f.q}</h3>
            <p class="mt-1.5 text-sm text-muted" style="line-height:1.55;" set:html={f.a} />
          </div>
        ))
      }
    </div>
  </section>
</Base>
