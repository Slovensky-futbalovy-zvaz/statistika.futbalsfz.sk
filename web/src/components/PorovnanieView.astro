---
import type { Porovnanie } from '../lib/data';
import { fmt } from '../lib/data';

interface Props {
  porovnanie: Porovnanie;
}
const { porovnanie } = Astro.props;
const rows = porovnanie.zvazy;

const metriky = [
  { key: 'zapasy', label: 'Zápasy' },
  { key: 'druzstva', label: 'Družstvá' },
  { key: 'goly', label: 'Góly' },
  { key: 'hraci', label: 'Hráči' },
  { key: 'divaci', label: 'Diváci' },
  { key: 'golyNaZapas', label: 'Góly/zápas' },
  { key: 'divaciNaZapas', label: 'Diváci/zápas' },
  { key: 'zlteKarty', label: 'Žlté karty' },
  { key: 'cerveneKarty', label: 'Červené karty' },
];

const chartH = Math.max(220, rows.length * 24 + 70);
---

<div data-porovnanie data-rows={JSON.stringify(rows)}>
  <div class="flex items-center gap-2 mb-3">
    <label class="text-sm text-sfz-muted" for="metrika">Zoradiť podľa:</label>
    <select id="metrika" class="rounded-md border border-black/15 px-2 py-1 text-sm bg-white">
      {metriky.map((m) => <option value={m.key}>{m.label}</option>)}
    </select>
  </div>

  <div class="chart w-full" style={`height:${chartH}px`} role="img" aria-label="Porovnanie zväzov"></div>

  <section class="mt-10">
    <h2 class="text-lg font-bold mb-1">Priame porovnanie zväzov</h2>
    <p class="text-sm text-sfz-muted mb-3">
      Vyber 2–5 zväzov. Radar zobrazuje hodnoty normalizované na maximum úrovne (100 % = najlepší
      zväz v danej metrike); skutočné hodnoty v tooltipe.
    </p>
    <div class="vyber flex flex-wrap gap-1.5 mb-4" role="group" aria-label="Výber zväzov na porovnanie">
      {
        rows.map((r) => (
          <button
            type="button"
            data-zvaz={r.id}
            class="vyber-chip rounded-md border border-black/10 px-2 py-0.5 text-sm text-sfz-blue hover:bg-black/5"
          >
            {r.nazov}
          </button>
        ))
      }
    </div>
    <div
      class="radar w-full hidden"
      style="height: 420px;"
      role="img"
      aria-label="Radarové porovnanie vybraných zväzov"
    >
    </div>
    <p class="radar-hint text-sm text-sfz-muted">Vyber aspoň 2 zväzy.</p>
  </section>

  <div class="mt-8 overflow-x-auto">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="text-left text-sfz-muted border-b border-black/10">
          <th class="py-1 pr-2 font-medium">#</th>
          <th class="py-1 pr-4 font-medium">Zväz</th>
          <th class="py-1 px-2 font-medium text-right">Zápasy</th>
          <th class="py-1 px-2 font-medium text-right">Družstvá</th>
          <th class="py-1 px-2 font-medium text-right">Góly</th>
          <th class="py-1 px-2 font-medium text-right">Hráči</th>
          <th class="py-1 px-2 font-medium text-right">Diváci</th>
          <th class="py-1 px-2 font-medium text-right">Góly/zápas</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r, i) => (
            <tr class="border-b border-black/5">
              <td class="py-1 pr-2 tabular-nums text-sfz-muted">{i + 1}</td>
              <td class="py-1 pr-4">
                <a class="text-sfz-blue hover:underline" href={`/zvaz/${r.id}`}>
                  {r.nazov}
                </a>
              </td>
              <td class="py-1 px-2 text-right tabular-nums">{fmt(r.zapasy)}</td>
              <td class="py-1 px-2 text-right tabular-nums">{fmt(r.druzstva)}</td>
              <td class="py-1 px-2 text-right tabular-nums">{fmt(r.goly)}</td>
              <td class="py-1 px-2 text-right tabular-nums">{fmt(r.hraci)}</td>
              <td class="py-1 px-2 text-right tabular-nums">{fmt(r.divaci)}</td>
              <td class="py-1 px-2 text-right tabular-nums">{r.golyNaZapas.toFixed(2)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<script>
  import * as echarts from 'echarts/core';
  import { BarChart, RadarChart } from 'echarts/charts';
  import { GridComponent, TooltipComponent, LegendComponent } from 'echarts/components';
  import { CanvasRenderer } from 'echarts/renderers';
  echarts.use([BarChart, RadarChart, GridComponent, TooltipComponent, LegendComponent, CanvasRenderer]);

  const REGION_COLOR: Record<string, string> = {
    BFZ: '#1450df',
    ZsFZ: '#2aa7ff',
    SsFZ: '#12b886',
    VsFZ: '#f59f00',
  };
  const LABELS: Record<string, string> = {
    zapasy: 'Zápasy',
    druzstva: 'Družstvá',
    goly: 'Góly',
    hraci: 'Hráči',
    divaci: 'Diváci',
    golyNaZapas: 'Góly/zápas',
    divaciNaZapas: 'Diváci/zápas',
    zlteKarty: 'Žlté karty',
    cerveneKarty: 'Červené karty',
  };
  const nf = new Intl.NumberFormat('sk-SK');

  type Row = Record<string, number | string>;

  const root = document.querySelector<HTMLElement>('[data-porovnanie]');
  if (root) {
    const rows = JSON.parse(root.dataset.rows ?? '[]') as Row[];
    const chartEl = root.querySelector<HTMLElement>('.chart')!;
    const sel = root.querySelector<HTMLSelectElement>('#metrika')!;
    const chart = echarts.init(chartEl, undefined, { renderer: 'canvas' });

    function render(metric: string) {
      // vzostupne → najväčší navrchu (ECharts kreslí kategórie zdola)
      const sorted = [...rows].sort((a, b) => (a[metric] as number) - (b[metric] as number));
      chart.setOption(
        {
          grid: { left: 8, right: 24, top: 10, bottom: 10, containLabel: true },
          tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
          xAxis: { type: 'value' },
          yAxis: {
            type: 'category',
            data: sorted.map((r) => r.nazov as string),
            axisLabel: { fontSize: 11 },
          },
          series: [
            {
              name: LABELS[metric],
              type: 'bar',
              data: sorted.map((r) => ({
                value: r[metric] as number,
                itemStyle: { color: REGION_COLOR[(r.rfz as string) ?? ''] ?? '#1450df' },
              })),
              label: { show: true, position: 'right', fontSize: 10, formatter: (p: any) => nf.format(p.value) },
            },
          ],
        },
        true,
      );
    }

    sel.addEventListener('change', () => render(sel.value));
    render(sel.value);
    new ResizeObserver(() => chart.resize()).observe(chartEl);

    // ---- Priame porovnanie 2–5 zväzov (radar) ----
    const MAX_VYBER = 5;
    const RADAR_METRIKY = [
      'zapasy',
      'druzstva',
      'goly',
      'hraci',
      'divaci',
      'golyNaZapas',
      'divaciNaZapas',
    ] as const;
    const RADAR_FARBY = ['#1450df', '#ec1c24', '#12b886', '#f59f00', '#7048e8'];

    // normalizácia: 100 % = maximum metriky v celej tabuľke (úroveň × sezóna),
    // takže tvar radaru je stabilný bez ohľadu na výber
    const maxima: Record<string, number> = {};
    for (const m of RADAR_METRIKY) {
      maxima[m] = Math.max(...rows.map((r) => (r[m] as number) || 0), 1);
    }

    const radarEl = root.querySelector<HTMLElement>('.radar')!;
    const hintEl = root.querySelector<HTMLElement>('.radar-hint')!;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.vyber-chip')];
    const radar = echarts.init(radarEl, undefined, { renderer: 'canvas' });
    const vybrane = new Set<string>();

    function renderRadar() {
      const vyber = rows.filter((r) => vybrane.has(r.id as string));
      const aktivny = vyber.length >= 2;
      radarEl.classList.toggle('hidden', !aktivny);
      hintEl.classList.toggle('hidden', aktivny);
      if (!aktivny) return;
      radar.setOption(
        {
          legend: { top: 0, data: vyber.map((r) => r.nazov as string) },
          tooltip: {
            trigger: 'item',
            formatter: (p: any) => {
              const r = vyber[p.dataIndex];
              const riadky = RADAR_METRIKY.map((m, i) => {
                const v = (r[m] as number) || 0;
                const txt = m === 'golyNaZapas' || m === 'divaciNaZapas' ? v.toFixed(2) : nf.format(v);
                return `${LABELS[m]}: <b>${txt}</b> (${Math.round(p.value[i])} %)`;
              });
              return `<b>${r.nazov}</b><br/>${riadky.join('<br/>')}`;
            },
          },
          radar: {
            indicator: RADAR_METRIKY.map((m) => ({ name: LABELS[m], max: 100 })),
            radius: '62%',
            axisName: { fontSize: 11, color: '#475569' },
          },
          series: [
            {
              type: 'radar',
              data: vyber.map((r, i) => ({
                name: r.nazov as string,
                value: RADAR_METRIKY.map((m) => (((r[m] as number) || 0) / maxima[m]) * 100),
                itemStyle: { color: RADAR_FARBY[i % RADAR_FARBY.length] },
                areaStyle: { opacity: 0.12 },
              })),
            },
          ],
        },
        true,
      );
      radar.resize();
    }

    function toggleChip(btn: HTMLButtonElement) {
      const id = btn.dataset.zvaz!;
      if (vybrane.has(id)) {
        vybrane.delete(id);
      } else {
        if (vybrane.size >= MAX_VYBER) return; // limit 5
        vybrane.add(id);
      }
      const aktivna = vybrane.has(id);
      btn.classList.toggle('bg-sfz-blue', aktivna);
      btn.classList.toggle('text-white', aktivna);
      btn.classList.toggle('border-sfz-blue', aktivna);
      btn.classList.toggle('font-semibold', aktivna);
      btn.classList.toggle('text-sfz-blue', !aktivna);
      btn.setAttribute('aria-pressed', String(aktivna));
      renderRadar();
    }

    chips.forEach((btn) => btn.addEventListener('click', () => toggleChip(btn)));
    // predvolený výber: prvé 3 zväzy tabuľky (okamžitá ukážka radaru)
    chips.slice(0, 3).forEach((btn) => toggleChip(btn));
    new ResizeObserver(() => radar.resize()).observe(radarEl);
  }
</script>
