---
// Interaktívna SVG mapa SR z web/assets/geo/mapa.json (viewBox + polygóny).
// Polygóny ObFZ sú preklikom na profil zväzu; farbené podľa RFZ regiónu.
import fs from 'node:fs';
import path from 'node:path';
import { geoNameToId, getZvazy } from '../lib/data';

interface Polygon {
  name: string;
  path: string;
}
interface Mapa {
  viewBox: string;
  slovensko: string;
  rfz: Polygon[];
  obfz: Polygon[];
}

const mapa: Mapa = JSON.parse(
  fs.readFileSync(path.resolve(process.cwd(), 'assets', 'geo', 'mapa.json'), 'utf-8'),
);

const geo = geoNameToId();
const zvazy = getZvazy();
const podlaId = new Map(zvazy.map((z) => [z.id, z]));

// RFZ skratka → farba (CSS premenná z brand tokenov)
function farbaRegionu(rfz?: string): string {
  switch (rfz) {
    case 'BFZ':
    case 'BA':
      return 'var(--color-rfz-ba)';
    case 'ZsFZ':
      return 'var(--color-rfz-zsfz)';
    case 'SsFZ':
      return 'var(--color-rfz-ssfz)';
    case 'VsFZ':
      return 'var(--color-rfz-vsfz)';
    default:
      return '#cbd5e1';
  }
}

const polygony = mapa.obfz.map((p) => {
  const id = geo[p.name];
  const z = id ? podlaId.get(id) : undefined;
  return {
    id,
    d: p.path,
    nazov: z?.nazov ?? p.name,
    farba: farbaRegionu(z?.rfz),
  };
});
---

<figure class="m-0">
  <svg
    viewBox={mapa.viewBox}
    role="img"
    aria-label="Mapa oblastných futbalových zväzov na Slovensku"
    class="w-full h-auto"
  >
    <path d={mapa.slovensko} fill="#f1f5f9" stroke="#e2e8f0" stroke-width="1" />
    {
      polygony.map((p) =>
        p.id ? (
          <a href={`/zvaz/${p.id}`} class="mapa-obfz">
            <path d={p.d} fill={p.farba} fill-opacity="0.82" stroke="#ffffff" stroke-width="0.8">
              <title>{p.nazov}</title>
            </path>
          </a>
        ) : (
          <path d={p.d} fill="#cbd5e1" stroke="#ffffff" stroke-width="0.8">
            <title>{p.nazov}</title>
          </path>
        ),
      )
    }
  </svg>
</figure>

<style>
  .mapa-obfz path {
    cursor: pointer;
    transition: fill-opacity 0.12s ease;
  }
  .mapa-obfz:hover path,
  .mapa-obfz:focus path {
    fill-opacity: 1;
    stroke-width: 1.4;
    outline: none;
  }
</style>
