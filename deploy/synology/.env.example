# Skopiruj na .env a dopln hodnoty (NEcommitovat).

# Read-only ucet na kolekcie sutaze a sportnet.users (polia birthdate, sex).
MONGODB_URI=mongodb+srv://readonly-user:HESLO@cluster.mongodb.net/?retryWrites=true&w=majority

# --- Volitelne ---
# Rucny prepocet JEDNEJ konkretnej sezony (inak sa plan urci automaticky: aktualna sezona
# + prekryv jul-september + sezony so zmenenym odtlackom). Necha sa zakomentovane pre
# planovany tyzdenny beh; pouziva sa pri jednorazovom prepocte staršej sezony.
# SEZONA=2024/2025

# Strop poctu sezon v jednom behu (default 4). Chrani pred tym, aby sa beh utrhol, keby
# sa odtlacok zmenil vo vela sezonach naraz. Preskocene sezony sa dobehnu nabudúce.
# MAX_SEZON=4
